$Version=2$
gift_associations_edit "widget/component-decl"
    {
    width = 590; height = 140;
    
    form "widget/parameter" { type = object; find_container = "widget/form"; }
    ledger "widget/parameter" { type = string; }
    editable_fields "widget/parameter"
	{
	// Valid values
	// - all:  Every field is editable.
	// - some: Only fields shared across multiple merged records
	//         (aka. different line items that are part of the same
	//         gift/transaction) are editable.
	// - none: None of the fields are editable.
	type = string;
	default = "none";
	enumlist = all,some,none;
	}
    
    cols "widget/hbox"
	{
	x = 0; y = 0; width = 590; height = 140; spacing = 5;
	
	col2 "widget/vbox"
	    {
	    y = 0; width = 200; height = 140; spacing = 10; // x = cols
	    
	    service_field "widget/component"
		{
		x = 0; width = 200; height = 15; label_width = 100; // y = col2
		path = "/sys/cmp/smart_field.cmp";
		text = "Service:";
		
		// Dropdown data.
		ctl_type = dropdown;
		field = i_eg_service;
		sql="
		    SELECT
			label = substring(:a_config_name, 12),
			value = substring(:a_config_name, 12),
			selected = 0
		    FROM
			/apps/kardia/data/Kardia_DB/a_config/rows
		    WHERE
			-- TODO: Uncomment after Noah fixes substring().
			-- substring(:a_config_name, 0, 11) = 'GiftImport_' AND
			:a_config_value = '1'
		    GROUP BY
			:a_config_name
		";
		form = form;
		
		mutable_service_hints "widget/hints"
		    {
		    condition = runserver(:this:editable_fields = "all" OR :this:editable_fields = "some");
		    style = applyonchange,notnull,strnull;
		    }
		immutable_service_hints "widget/hints"
		    {
		    condition = runserver(:this:editable_fields = "none");
		    style = readonly;
		    }
		}
	    
	    donor_name_field "widget/component"
		{
		x = 0; width = 200; height = 15; label_width = 100; // y = col2
		path = "/sys/cmp/smart_field.cmp";
		text = "Donor Name:";
		ctl_type = editbox;
		field = i_eg_donor_name;
		form = form;
		
		mutable_donor_name_hints "widget/hints"
		    {
		    condition = runserver(:this:editable_fields = "all" OR :this:editable_fields = "some");
		    style = applyonchange,notnull,strnull;
		    }
		immutable_donor_name_hints "widget/hints"
		    {
		    condition = runserver(:this:editable_fields = "none");
		    style = readonly;
		    }
		}
	    
	    donor_address_field "widget/component"
		{
		x = 0; width = 200; height = 15; label_width = 100; // y = col2
		path = "/sys/cmp/smart_field.cmp";
		text = "Donor Address:";
		ctl_type = editbox;
		field = i_eg_donor_address;
		form = form;
		
		mutable_donor_address_hints "widget/hints"
		    {
		    condition = runserver(:this:editable_fields = "all" OR :this:editable_fields = "some");
		    style = applyonchange;
		    }
		immutable_donor_address_hints "widget/hints"
		    {
		    condition = runserver(:this:editable_fields = "none");
		    style = readonly;
		    }
		}
	    
	    divider_spacer2 "widget/autolayoutspacer" { height = 5; }
	    
	    kardia_donor_field "widget/component"
		{
		x = 0; width = 200; height = 15; label_width = 100; // y = col2
		path = "/apps/kardia/modules/base/editbox_table.cmp";
		text = "Donor:";
		field = p_donor_partner_key;
		form = form;
		validate = 1;
		
		// Popup
		popup_text = "Select a Donor:";
		popup_width = 335;
		popup_sql = "
		    SELECT
			value = :p:p_partner_key + '', -- Stop failed auto-writes to DB.
			label = isnull(condition(
			    char_length(rtrim(:p:p_org_name)) > 0,
			    :p:p_org_name,
			    :p:p_given_name + ' ' + :p:p_surname,
			) + ' ', '')
			+ isnull(
			    ' ['
				+ :pl:p_city + ', '
				+ :pl:p_state_province + ' '
				+ :pl:p_postal_code
			    + '] ',
			'')
		    FROM
			/apps/kardia/data/Kardia_DB/p_partner/rows p,
			/apps/kardia/data/Kardia_DB/p_location/rows pl
		    WHERE
			:p:p_partner_key *= :pl:p_partner_key
		    GROUP BY
			:p:p_partner_key
		";
		search_field_list = ""
		    + "p_partner_key,"
		    + "*p_given_name*,"
		    + "*p_preferred_name*,"
		    + "*p_surname*,"
		    + "*p_localized_name*,"
		    + "*p_org_name*,"
		    + "*p_comments*,"
		    + "p_legacy_key_1,"
		    + "*p_legacy_key_2*";
		search_objname = p;
		key_name = p_partner_key;
		
		mutable_kardia_donor_hints "widget/hints"
		    {
		    condition = runserver(:this:editable_fields = "all" OR :this:editable_fields = "some");
		    style = applyonchange,notnull,strnull;
		    }
		immutable_kardia_donor_hints "widget/hints"
		    {
		    condition = runserver(:this:editable_fields = "none");
		    style = readonly;
		    }
		}
	    }
	
	// col3 (Desig. ID/Name) and col4 (Gross/Net Amount) combined so that
	// Desig. Notes can span the full width of both columns.
	col3_and_4 "widget/vbox"
	    {
	    y = 0; width = 375; height = 140; spacing = 10; // x = cols
	    
	    col3_and_4_top "widget/hbox"
		{
		width = 375; height = 40; spacing = 5;
		
		col3_top "widget/vbox"
		    {
		    y = 0; width = 200; height = 40; spacing = 10;
		    
		    desig_id_field "widget/component"
			{
			condition = runserver(:this:editable_fields != "some");
			x = 0; width = 200; height = 15; label_width = 100; // y = col3_top
			path = "/sys/cmp/smart_field.cmp";
			text = "Desig. ID:";
			ctl_type = editbox;
			field = i_eg_desig_uuid;
			form = form;
			
			mutable_desig_id_hints "widget/hints"
			    {
			    condition = runserver(:this:editable_fields = "all");
			    style = applyonchange,notnull,strnull;
			    }
			
			immutable_desig_id_hints "widget/hints"
			    {
			    condition = runserver(:this:editable_fields = "none");
			    style = readonly;
			    }
			}
		    desig_id_placeholder "widget/component"
			{
			condition = runserver(:this:editable_fields = "some");
			x = 0; width = 200; height = 15; label_width = 100; // y = col3_top
			path = "/sys/cmp/smart_field.cmp";
			text = "Desig. ID:";
			ctl_type = label;
			value = "See Details";
			}

		    desig_name_field "widget/component"
			{
			condition = runserver(:this:editable_fields != "some");
			x = 0; width = 200; height = 15; label_width = 100; // y = col3_top
			path = "/sys/cmp/smart_field.cmp";
			text = "Desig. Name:";
			ctl_type = editbox;
			field = i_eg_desig_name;
			form = form;
			
			mutable_desig_name_hints "widget/hints"
			    {
			    condition = runserver(:this:editable_fields = "all");
			    style = applyonchange,notnull,strnull;
			    }
			
			immutable_desig_name_hints "widget/hints"
			    {
			    condition = runserver(:this:editable_fields = "none");
			    style = readonly;
			    }
			}
		    desig_name_placeholder "widget/component"
			{
			condition = runserver(:this:editable_fields = "some");
			x = 0; width = 200; height = 15; label_width = 100; // y = col3_top
			path = "/sys/cmp/smart_field.cmp";
			text = "Desig. Name:";
			ctl_type = label;
			value = "See Details";
			}
		    }
		
		col4_top "widget/vbox"
		    {
		    y = 0; width = 170; height = 40; spacing = 10;
		    
		    gross_amount_field "widget/component"
			{
			x = 0; width = 170; height = 15; label_width = 100; // y = col4_top
			path = "/sys/cmp/smart_field.cmp";
			text = "Gross Amount:";
			ctl_type = editbox;
			field = i_eg_deposit_gross_amt;
			form = form;
			
			mutable_gross_amount_hints "widget/hints"
			    {
			    condition = runserver(:this:editable_fields = "all");
			    style = applyonchange,notnull,strnull;
			    default = runclient(0);
			    }
			
			immutable_gross_amount_hints "widget/hints"
			    {
			    condition = runserver(:this:editable_fields = "none" OR :this:editable_fields = "some");
			    style = readonly;
			    }
			}
		    
		    net_amount_field "widget/component"
			{
			x = 0; width = 170; height = 15; label_width = 100; // y = col4_top
			path = "/sys/cmp/smart_field.cmp";
			text = "Net Amount:";
			ctl_type = editbox;
			field = i_eg_net_amount;
			form = form;
			
			mutable_net_amount_hints "widget/hints"
			    {
			    condition = runserver(:this:editable_fields = "all");
			    style = applyonchange,notnull,strnull;
			    default = runclient(0);
			    }
			
			immutable_net_amount_hints "widget/hints"
			    {
			    condition = runserver(:this:editable_fields = "none" OR :this:editable_fields = "some");
			    style = readonly;
			    }
			}
		    }
		}
	    
	    desig_notes_field "widget/component"
		{
		condition = runserver(:this:editable_fields != "some");
		x = 0; width = 375; height = 15; label_width = 100; // y = col3_and_4
		path = "/sys/cmp/smart_field.cmp";
		text = "Desig. Notes:";
		ctl_type = editbox;
		field = i_eg_desig_notes;
		form = form;
		
		mutable_desig_notes_hints "widget/hints"
		    {
		    condition = runserver(:this:editable_fields = "all");
		    style = applyonchange;
		    }
		immutable_desig_notes_hints "widget/hints"
		    {
		    condition = runserver(:this:editable_fields = "none");
		    style = readonly;
		    }
		}
	    desig_notes_placeholder "widget/component"
		{
		condition = runserver(:this:editable_fields = "some");
		x = 0; width = 375; height = 15; label_width = 100; // y = col3_and_4
		path = "/sys/cmp/smart_field.cmp";
		text = "Desig. Notes:";
		ctl_type = label;
		value = "See Details";
		}
	    
	    divider_spacer3 "widget/autolayoutspacer" { height = 5; }
	    
	    col3_and_4_bottom "widget/hbox"
		{
		width = 375; height = 15; spacing = 5;
		
		kardia_designation_field "widget/component"
		    {
		    condition = runserver(:this:editable_fields != "some");
		    x = 0; width = 200; height = 15; label_width = 100; // y = col3_and_4_bottom
		    path = "/apps/kardia/modules/base/editbox_table.cmp";
		    text = "Desig.:";
		    field = a_fund;
		    form = form;
		    validate = 1;
		    
		    // Popup
		    popup_text = "Select a Designation:";
		    popup_width = 335;
		    popup_sql = runserver("
			SELECT
			    value = :c:a_fund + '', -- Stop failed auto-writes to DB.
			    label = condition(
				isnull(:cr:a_receiptable, 0) = 1,
				:c:a_fund_desc + isnull(' - legacy #' + :c:a_legacy_code, ''),
				'** CLOSED **'
			    )
			FROM
			    /apps/kardia/data/Kardia_DB/a_fund/rows c,
			    /apps/kardia/data/Kardia_DB/a_fund_receipting/rows cr
			WHERE
			    :c:a_ledger_number = " + quote(:this:ledger) + " AND
			    :cr:a_ledger_number =* :c:a_ledger_number AND
			    :cr:a_fund =* :c:a_fund AND
			    :c:a_is_posting = 1
		    ");
		    search_field_list = ""
			+ "*a_fund*,"
			+ "*a_fund_desc*,"
			+ "*a_fund_comments*,"
			+ "*a_legacy_code*";
		    search_objname = c;
		    key_name = a_fund;
		    
		    mutable_kardia_designation_hints "widget/hints"
			{
			condition = runserver(:this:editable_fields = "all");
			style = applyonchange,notnull,strnull;
			}
		    immutable_kardia_designation_hints "widget/hints"
			{
			condition = runserver(:this:editable_fields = "none");
			style = readonly;
			}
		    }
		kardia_designation_placeholder "widget/component"
		    {
		    condition = runserver(:this:editable_fields = "some");
		    x = 0; width = 200; height = 15; label_width = 100; // y = col3_and_4_bottom
		    path = "/sys/cmp/smart_field.cmp";
		    text = "Desig.:";
		    ctl_type = label;
		    value = "See Details";
		    }
		
		kardia_gl_account_field "widget/component"
		    {
		    condition = runserver(:this:editable_fields != "some");
		    x = 0; width = 170; height = 15; label_width = 100; // y = col3_and_4_bottom
		    path = "/apps/kardia/modules/base/editbox_table.cmp";
		    text = "GL Account:";
		    field = a_account_code;
		    form = form;
		    validate = 1;
		    
		    // Popup
		    popup_text = "Select a GL Account:";
		    popup_width = 335;
		    popup_sql = runserver("
			SELECT
			    value = :a_account_code + '', -- Stop failed auto-writes to DB.
			    label = isnull(:a_acct_desc + ' ', '')
			FROM
			    /apps/kardia/data/Kardia_DB/a_account/rows
			WHERE
			    :a_ledger_number = " + quote(:this:ledger) + " AND
			    :a_is_posting = 1
			ORDER BY
			    :a_account_code
		    ");
		    search_field_list = ""
			+ "*a_account_code*,"
			+ "*a_acct_desc*,"
			+ "*a_acct_comment*";
		    key_name = a_account_code;
		    
		    mutable_gl_account_hints "widget/hints"
			{
			condition = runserver(:this:editable_fields = "all");
			style = applyonchange,notnull,strnull;
			}
		    
		    immutable_gl_account_hints "widget/hints"
			{
			condition = runserver(:this:editable_fields = "none");
			style = readonly;
			}
		    }
		kardia_gl_account_placeholder "widget/component"
		    {
		    condition = runserver(:this:editable_fields = "some");
		    x = 0; width = 170; height = 15; label_width = 100; // y = col3_and_4_bottom
		    path = "/sys/cmp/smart_field.cmp";
		    text = "GL Account:";
		    ctl_type = label;
		    value = "See Details";
		    }
		}
	    }
	}
    }
