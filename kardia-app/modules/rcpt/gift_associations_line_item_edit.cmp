$Version=2$
// The per-line-item detail fields shown in the Line Item Details window of the
// Gift Associations app.
gift_associations_line_item_edit "widget/component-decl"
    {
    width = 455; height = 160;

    form "widget/parameter" { type = object; find_container = "widget/form"; }
    ledger "widget/parameter" { type = string; }

    edit_mode "widget/parameter"
	{
	// Whether the fields accept user input.
	// - editable: Fields are editable.
	// - readonly: Fields are shown, but not editable.
	type = string;
	default = "readonly";
	enumlist = editable,readonly;
	}

    kardia_label "widget/label"
	{
	x = 10; y = 5; width = 300; height = 16;
	font_size = 12; style = bold;
	text = "Kardia Association:";
	}

    kardia_row "widget/hbox"
	{
	x = 10; y = 24; width = 445; height = 24; spacing = 10;

	fund_desig_field "widget/component"
	    {
	    y = 0; width = 215; height = 24; label_width = 80; // x = kardia_row
	    path = "/apps/kardia/modules/base/editbox_table.cmp";
	    text = "Fund/Desig.:";
	    field = a_fund;
	    form = form;

	    // Popup
	    popup_text = "Select a Designation:";
	    popup_width = 335;
	    popup_sql = runserver("
		SELECT
		    value = :c:a_fund + '', -- Stop failed auto-writes to DB.
		    label = condition(
			isnull(:cr:a_receiptable, 0) = 1,
			''  + isnull(:c:a_fund_desc + ' ', '')
			    + '(' + :c:a_fund + ')'
			    + isnull(' - legacy #' + :c:a_legacy_code, ''),
			'** CLOSED **'
		    )
		FROM
		    /apps/kardia/data/Kardia_DB/a_fund/rows c,
		    /apps/kardia/data/Kardia_DB/a_fund_receipting/rows cr
		WHERE
		    :c:a_ledger_number = " + quote(:this:ledger) + " AND
		    :c:a_ledger_number *= :cr:a_ledger_number AND
		    :c:a_fund *= :cr:a_fund AND
		    :c:a_is_posting = 1
	    ");
	    search_field_list = ""
		+ "*a_fund*,"
		+ "*a_fund_desc*,"
		+ "*a_legacy_code*";
	    search_objname = c;
	    key_name = a_fund;

	    editable_fund_desig_hints "widget/hints"
		{
		condition = runserver(:this:edit_mode = "editable");
		style = applyonchange,notnull,strnull;
		}
	    immutable_fund_desig_hints "widget/hints"
		{
		condition = runserver(:this:edit_mode = "readonly");
		style = readonly;
		}
	    }

	gl_account_field "widget/component"
	    {
	    y = 0; width = 215; height = 24; label_width = 80; // x = kardia_row
	    path = "/apps/kardia/modules/base/editbox_table.cmp";
	    text = "GL Account:";
	    field = a_account_code;
	    form = form;

	    // Popup
	    popup_text = "Select a GL Account:";
	    popup_width = 335;
	    popup_sql = runserver("
		SELECT
		    value = :a_account_code + '', -- Stop failed auto-writes to DB.
		    label = ''
			+ isnull(nullif(:a_acct_desc, '') + ' ', '')
			+ isnull('(' + :a_account_code + ')', '')
		FROM
		    /apps/kardia/data/Kardia_DB/a_account/rows
		WHERE
		    :a_ledger_number = " + quote(:this:ledger) + " AND
		    :a_is_posting = 1
		ORDER BY
		    :a_account_code
	    ");
	    search_field_list = ""
		+ "*a_account_code*,"
		+ "*a_acct_desc*,"
		+ "*a_acct_comment*,"
		+ "*a_legacy_code*";
	    key_name = a_account_code;

	    editable_gl_account_hints "widget/hints"
		{
		condition = runserver(:this:edit_mode = "editable");
		style = applyonchange,notnull,strnull;
		}
	    immutable_gl_account_hints "widget/hints"
		{
		condition = runserver(:this:edit_mode = "readonly");
		style = readonly;
		}
	    }
	}

    kardia_service_divider "widget/pane"
	{
	x = 10; y = 52; width = 440; height = 2; style = border;
	}

    service_label "widget/label"
	{
	x = 10; y = 58; width = 300; height = 16;
	font_size = 12; style = bold;
	text = "Giving Service Info:";
	}

    service_row "widget/hbox"
	{
	x = 10; y = 77; width = 445; height = 80; spacing = 20;

	service_info_left_col "widget/vbox"
	    {
	    y = 0; width = 210; height = 80; spacing = 8; // x = service_row

	    gift_amount_field "widget/component"
		{
		x = 0; width = 210; height = 20; label_width = 80; // y = service_info_left_col
		path = "/sys/cmp/smart_field.cmp";
		text = "Gift Amount";
		ctl_type = editbox;
		field = i_eg_gift_amount;
		form = form;

		editable_gift_amount_hints "widget/hints"
		    {
		    condition = runserver(:this:edit_mode = "editable");
		    style = applyonchange;
		    }
		immutable_gift_amount_hints "widget/hints"
		    {
		    condition = runserver(:this:edit_mode = "readonly");
		    style = readonly;
		    }
		}

	    net_amount_field "widget/component"
		{
		x = 0; width = 210; height = 20; label_width = 80; // y = service_info_left_col
		path = "/sys/cmp/smart_field.cmp";
		text = "Net Amount:";
		ctl_type = editbox;
		field = i_eg_net_amount;
		form = form;

		editable_net_amount_hints "widget/hints"
		    {
		    condition = runserver(:this:edit_mode = "editable");
		    style = applyonchange;
		    }
		immutable_net_amount_hints "widget/hints"
		    {
		    condition = runserver(:this:edit_mode = "readonly");
		    style = readonly;
		    }
		}

	    desig_id_field "widget/component"
		{
		x = 0; width = 210; height = 20; label_width = 80; // y = service_info_left_col
		path = "/sys/cmp/smart_field.cmp";
		text = "Desig. ID:";
		ctl_type = editbox;
		field = i_eg_desig_uuid;
		form = form;

		editable_desig_id_hints "widget/hints"
		    {
		    condition = runserver(:this:edit_mode = "editable");
		    style = applyonchange;
		    }
		immutable_desig_id_hints "widget/hints"
		    {
		    condition = runserver(:this:edit_mode = "readonly");
		    style = readonly;
		    }
		}
	    }

	service_info_right_col "widget/vbox"
	    {
	    y = 0; width = 210; height = 80; spacing = 2; // x = service_row

	    desig_notes_label "widget/label"
		{
		x = 0; width = 210; height = 15; // y = service_info_right_col
		text = "Desig. Notes:";
		style = italic;
		}

	    desig_notes_field "widget/component"
		{
		x = 0; width = 210; height = 60; // y = service_info_right_col
		path = "/sys/cmp/smart_field.cmp";
		text = "";
		label_width = 0;
		ctl_type = textarea;
		field = i_eg_desig_notes;
		form = form;

		editable_desig_notes_hints "widget/hints"
		    {
		    condition = runserver(:this:edit_mode = "editable");
		    style = applyonchange;
		    }
		immutable_desig_notes_hints "widget/hints"
		    {
		    condition = runserver(:this:edit_mode = "readonly");
		    style = readonly;
		    }
		}
	    }
	}
    }
