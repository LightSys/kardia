$Version=2$
plugin_rcpt_importprocess_050splitTrx "system/query"
    {
    module_sequence=50; // want to run before matching
    module_letter='S';
    module_code='Split';
    module_desc='Split combined gifts comming from bill pay transactions';
    // just an example of how to specify a module config component:
    // module_config_cmp='/apps/kardia/modules/rcpt/field_donor_with_new.cmp';

    ledger "query/parameter" { type=string; }

    sql = "
		-- Collect all of the single line transactions that may need split
		DECLARE COLLECTION to_split_sums;
		INSERT INTO 
		    COLLECTION to_split_sums
		SELECT 
		    :i_eg_trx_uuid, :i_eg_donor_uuid, :i_eg_desig_notes, :i_eg_service, 
		    gift_sum = sum(:i_eg_gift_amount), 
		    net_sum = sum(:i_eg_net_amount)
		FROM
		    IDENTITY /apps/kardia/data/Kardia_DB/i_eg_gift_import/rows
		WHERE
		    substring(:i_eg_postprocess, 1, 1) = 'S'
		    AND :a_ledger_number = :parameters:ledger
		    AND :i_eg_status != 'template'
		GROUP BY
		    :i_eg_trx_uuid
		HAVING 
		    count(1) == 1
		;

		-- now find any historical matches
		DECLARE COLLECTION matches;
		INSERT INTO
		    COLLECTION matches
		SELECT
		    :match:i_eg_service, :match:i_eg_desig_notes, 
		    :match:i_eg_donor_uuid, :match:i_eg_gift_date,
		    :match:i_eg_service,
		    gift_sum = sum(:match:i_eg_gift_amount), 
		    net_sum = sum(:match:i_eg_net_amount),
		    hist_trx =  :match:i_eg_trx_uuid,
		    split_trx = :split:i_eg_trx_uuid
		FROM
		    IDENTITY /apps/kardia/data/Kardia_DB/i_eg_gift_import/rows match, -- only pull in matches
		    COLLECTION to_split_sums split
		WHERE
		    -- matching is based on ledger, service, desig notes, donor, and gift totals (in the HAVING clause)
		    :match:a_ledger_number = :parameters:ledger
		    AND substring(isnull(:match:i_eg_postprocess, ''), 1, 1) != 'S'
		    AND :match:i_eg_desig_notes = :split:i_eg_desig_notes
		    AND :match:i_eg_donor_uuid = :split:i_eg_donor_uuid
		    AND :match:i_eg_service = :split:i_eg_service
		GROUP BY
		    :match:i_eg_trx_uuid, -- the collection is already grouped, so just use match
		    :split:i_eg_trx_uuid -- if multiple match at the same time, don't want to mix
		HAVING
		    sum(:match:i_eg_gift_amount) = :split:gift_sum
		    --  FIXME: what if we split before the deposit, and then the net is different next time we see it...?
		    AND sum(:match:i_eg_net_amount) = isnull(:split:net_sum, sum(:match:i_eg_net_amount))
		    AND count(1) > 1
		-- Just keep the most recent transaction for each
		ON DUPLICATE 
		    :split_trx
		UPDATE SET
 		    :hist_trx = condition(:i_eg_gift_date > :match:i_eg_gift_date, :hist_trx, :match:i_eg_trx_uuid),
		    :i_eg_gift_date = condition(:i_eg_gift_date > :match:i_eg_gift_date, :i_eg_gift_date, :match:i_eg_gift_date)
		;

		-- Ideally, we would do a 3 way join to connect history_match with gifts to split 
		-- and the gifts to copy in i_eg_gift import, however, that will likely be too slow
		-- Instead, we will store the relevant rows in two collections, and then perform the 
		-- 3 way join between the 3, far smaller collections

		-- Get the rows to split
		DECLARE COLLECTION to_split;
		INSERT INTO 
		    COLLECTION to_split
		SELECT
		    *
		FROM
		    IDENTITY /apps/kardia/data/Kardia_DB/i_eg_gift_import/rows split, 
		    COLLECTION matches match
		WHERE
		    :match:split_trx = :split:i_eg_trx_uuid
		    AND :split:a_ledger_number = :parameters:ledger
		    AND :match:i_eg_service = :split:i_eg_service
		    AND substring(:split:i_eg_postprocess, 1, 1) = 'S'
		;

		-- Get the rows to copy
		DECLARE COLLECTION gift_hist;
		INSERT INTO 
		    COLLECTION gift_hist
		SELECT
		    *
		FROM
		    IDENTITY /apps/kardia/data/Kardia_DB/i_eg_gift_import/rows hist, 
		    COLLECTION matches match
		WHERE
		    :match:hist_trx = :hist:i_eg_trx_uuid
		    AND :hist:a_ledger_number = :parameters:ledger
		    AND :match:i_eg_service = :hist:i_eg_service
		    AND substring(isnull(:hist:i_eg_postprocess, ''), 1, 1) != 'S'
		;


		-- try to match the queries with an existing transaction. If can't, will need manually done. 
		DECLARE COLLECTION final;
		INSERT INTO 
		    COLLECTION final
		SELECT 
		    -- debug
		    split_trx = :split:i_eg_trx_uuid,
		    hist_trx = :hist:i_eg_trx_uuid,
		    -- old pk
		    original_desig = :split:i_eg_desig_uuid,
		    original_line_item = :split:i_eg_line_item,
		    -- Values for insert
		    :split:i_eg_gift_uuid,
		    :hist:i_eg_desig_uuid,
		    :hist:i_eg_line_item,
		    :split:i_eg_trx_uuid,
		    :split:i_eg_donor_uuid,
		    :split:i_eg_donor_alt_id,
		    :split:i_eg_account_uuid,
		    :split:i_eg_status,
		    :split:i_eg_returned_status,
		    :split:i_eg_donor_name,
		    :split:i_eg_donor_given_name,
		    :split:i_eg_donor_surname,
		    :split:i_eg_donor_middle_name,
		    :split:i_eg_donor_prefix,
		    :split:i_eg_donor_suffix,
		    :split:i_eg_donor_address,
		    :split:i_eg_donor_addr1,
		    :split:i_eg_donor_addr2,
		    :split:i_eg_donor_addr3,
		    :split:i_eg_donor_city,
		    :split:i_eg_donor_state,
		    :split:i_eg_donor_postal,
		    :split:i_eg_donor_country,
		    :split:i_eg_donor_phone,
		    :split:i_eg_donor_email,
		    :hist:i_eg_gift_amount,
		    :hist:i_eg_net_amount,
		    :split:i_eg_deposit_gross_amt,
		    :split:i_eg_deposit_amt,
		    :split:i_eg_deposit_date,
		    :split:i_eg_deposit_status, 
		    :split:i_eg_deposit_uuid,
		    :split:i_eg_gift_pmt_type,
		    :split:i_eg_gift_interval,
		    :split:i_eg_gift_start_date,
		    :split:i_eg_gift_end_date,
		    :split:i_eg_gift_count,
		    :split:i_eg_gift_date,
		    :split:i_eg_gift_trx_date,
		    :split:i_eg_gift_settlement_date, 
		    :split:i_eg_gift_lastfour,
		    :split:i_eg_desig_name,
		    :split:i_eg_desig_notes,
		    i_eg_postprocess = substring(:split:i_eg_postprocess, 2),	-- may need post processing from later modules
		    :split:i_eg_service,
		    :split:i_eg_processor,
		    :split:i_eg_gift_currency,
		    :split:i_eg_receipt_desired,
		    :split:i_eg_anonymous,
		    :split:i_eg_prayforme,
		    :split:i_eg_acctmap_future,
		    :split:i_eg_fundmap_future,
		    :split:i_eg_donormap_future,
		    :split:a_ledger_number,
		    :split:s_date_created,
		    :split:s_created_by
		FROM
		    IDENTITY COLLECTION to_split split,	-- the transactions to split
		    IDENTITY COLLECTION gift_hist hist,	-- the preexisting transaction to copy
		    COLLECTION matches match 							-- the guide for what to match with
		WHERE
		    :match:hist_trx = :hist:i_eg_trx_uuid
		    AND :match:split_trx = :split:i_eg_trx_uuid
		    AND :hist:i_eg_service = :split:i_eg_service
		--    AND :m:i_eg_service = :i:i_eg_service
		--    AND :s:a_ledger_number = :parameters:ledger
		--    AND :i:a_ledger_number = :parameters:ledger
		--    AND substring(:s:i_eg_postprocess, 1, 1) = 'S'
		--    AND isnull(:s:i_eg_desig_notes, '') = isnull(:i:i_eg_desig_notes,'') -- make sure what donor sent was the same
		--    AND :s:i_eg_donor_uuid = :i:i_eg_donor_uuid -- make sure was the same donor
		--    AND isnull(:s:i_eg_deposit_amt, :i:i_eg_deposit_amt) = :i:i_eg_deposit_amt -- need to let null net values pass for now
		--    AND :s:i_eg_deposit_gross_amt = :i:i_eg_deposit_gross_amt
		--    AND isnull(:s:i_eg_deposit_amt, 0) = isnull(:s:i_eg_net_amount, 0) -- make sure only one item in transaction to be split
		--    AND :s:i_eg_deposit_gross_amt = :s:i_eg_gift_amount
		--    AND :s:i_eg_service = :i:i_eg_service
		--    AND :s:i_eg_status != 'template'
		;

		-- TODO: we can no longer easily check that the sums line up, but we may want to mark something with a desig ID that indicates a split was needed, but none was found here...?


		-- list all of the rows to delete later
		DECLARE COLLECTION trx_uuids;
		INSERT INTO
		    COLLECTION trx_uuids
		SELECT
		    :s:i_eg_trx_uuid,
		    :s:i_eg_service,
		    :s:original_desig,
		    :s:original_line_item
		FROM
		    COLLECTION final s
		GROUP BY 
		    :s:i_eg_trx_uuid
		;

		-- Delete any transactions that have already been split. (i.e. have an id in trx_uuid)
		-- Use the full PK. i_eg_service is included in case it is ever added to the PK, and check i_eg_postprocess to be sure no mistakes were made
		DELETE 
		FROM
		    IDENTITY /apps/kardia/data/Kardia_DB/i_eg_gift_import/rows i,
		    COLLECTION trx_uuids u
		WHERE 
		    substring(:i_eg_postprocess, 1, 1) = 'S'
		    AND :i:a_ledger_number = :parameters:ledger
		    AND :i:i_eg_trx_uuid = :u:i_eg_trx_uuid  -- limits to just the items worked on
		    AND :i:i_eg_service = :u:i_eg_service
		    AND :i:i_eg_desig_uuid = :u:original_desig
		    AND :i:i_eg_line_item = :u:original_line_item
		;

		-- write the new columns to the table
		INSERT INTO
		    /apps/kardia/data/Kardia_DB/i_eg_gift_import/rows
		SELECT
		    :s:i_eg_trx_uuid,		:s:i_eg_gift_uuid,		:s:i_eg_desig_uuid, :s:i_eg_line_item,
		    :s:i_eg_donor_uuid, 	:s:i_eg_donor_alt_id,		:s:i_eg_account_uuid, :s:i_eg_status,
		    :s:i_eg_returned_status, 	:s:i_eg_donor_name,		:s:i_eg_donor_given_name, 
		    :s:i_eg_donor_surname, 	:s:i_eg_donor_middle_name,	:s:i_eg_donor_prefix,
		    :s:i_eg_donor_suffix, 	:s:i_eg_donor_address,		:s:i_eg_donor_addr1,
		    :s:i_eg_donor_addr2,	:s:i_eg_donor_addr3,		:s:i_eg_donor_city,
		    :s:i_eg_donor_state,	:s:i_eg_donor_postal,		:s:i_eg_donor_country,
		    :s:i_eg_donor_phone,	:s:i_eg_donor_email,		:s:i_eg_gift_amount,
		    :s:i_eg_net_amount,		:s:i_eg_deposit_gross_amt,	:s:i_eg_deposit_amt,
		    :s:i_eg_deposit_date,	:s:i_eg_deposit_status, 	:s:i_eg_deposit_uuid,
		    :s:i_eg_gift_pmt_type,	:s:i_eg_gift_interval,		:s:i_eg_gift_start_date,
		    :s:i_eg_gift_end_date,	:s:i_eg_gift_count,		:s:i_eg_gift_date,
		    :s:i_eg_gift_trx_date,	:s:i_eg_gift_settlement_date,	:s:i_eg_gift_lastfour,
		    :s:i_eg_desig_name,		:s:i_eg_desig_notes,		:s:i_eg_postprocess,
		    :s:i_eg_service,		:s:i_eg_processor,		:s:i_eg_gift_currency,
		    :s:i_eg_receipt_desired,	:s:i_eg_anonymous,		:s:i_eg_prayforme,
		    :s:i_eg_acctmap_future,	:s:i_eg_fundmap_future,		:s:i_eg_donormap_future,
		    :s:a_ledger_number,
		    :s:s_date_created,
		    :s:s_created_by,
		    s_date_modified = getdate(),
		    s_modified_by = user_name()
		FROM 
		    COLLECTION final s
		ON DUPLICATE
		    :a_ledger_number, :i_eg_trx_uuid, :i_eg_desig_uuid, :i_eg_line_item, :i_eg_service
		UPDATE SET
		    :i_eg_deposit_date = :s:i_eg_deposit_date,
		    :i_eg_deposit_uuid = :s:i_eg_deposit_uuid,
		    :i_eg_deposit_gross_amt = :s:i_eg_deposit_gross_amt,
		    :i_eg_deposit_amt = :s:i_eg_deposit_amt,
		    :i_eg_net_amount = :s:i_eg_net_amount,
		    :i_eg_desig_notes = :s:i_eg_desig_notes,
		    :i_eg_status = :s:i_eg_status,
		    :i_eg_returned_status = :s:i_eg_returned_status,
		    :i_eg_gift_settlement_date = :s:i_eg_gift_settlement_date,
		    :s_date_modified = getdate() IF MODIFIED,
		    :s_modified_by = user_name() IF MODIFIED
		;

		-- If it still has an S, can assume does not need it
		UPDATE 
		    /apps/kardia/data/Kardia_DB/i_eg_gift_import/rows
		SET 
		    :i_eg_postprocess = substring(:i_eg_postprocess, 2)
		WHERE 
		    substring(:i_eg_postprocess, 1, 1) = 'S'
		    AND :a_ledger_number = :parameters:ledger
		;
    ";
    }