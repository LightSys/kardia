$Version=2$
deposits_import_method "system/query"
    {
    ledger "query/parameter" { type=string; style=notnull,strnull; }
    ptime "query/parameter" { type=string; style=strnull; }
    pstat "query/parameter" { type=string; style=strnull; }
    period "query/parameter" { type=string; style=strnull; }
    deposit_batch "query/parameter" { type=integer; style=strnull; }
    batchtype "query/parameter" { type=string; default="deposits"; }
    byfund "query/parameter" { type=integer; default=0; }

    sql = " select
		    :cnt,
		    item = dense_rank(:i_eg_deposit_uuid),

		    -- Deposit amount depends on deposit method (gross vs net vs other/none)
		    deposit_amt = condition(:dep_method == 'G', :deposit_gross_amt, condition(:dep_method = 'N', :deposit_net_amt, null)),

		    -- Any importable fees
		    fees_anymethod_amt = condition(:fee_method = 'N' or :fee_method = 'D' or :fee_method = 'P', :fees_amt, null),

		    -- Fees subtracted from deposits in the GL via the receipts asset account / undeposited funds
		    fees_amt = condition(:fee_method = 'N', :fees_amt, null),

		    -- Fees posted via Disbursements
		    fees_disbursed_amt = condition(:fee_method = 'D', :fees_amt, null),
		    fees_disbursed_date = :deposit_date,
		    fees_disbursed_payee = :fee_payee,

		    -- Fees posted to a payable account
		    fees_payable_amt = condition(:fee_method = 'P', :fees_amt, null),
		    fees_payable_fund = :fee_fund,
		    fees_payable_acct = :fee_acct,

		    -- Misc data
		    :i_eg_deposit_uuid,
		    :i_eg_service,
		    :deposit_date,
		    :deposit_gross_amt,
		    :deposit_net_amt,
		    :period,
		    :ledger,
		    :fund,
		    :processor,
		    :min_date_trx,
		    :max_date_trx,
		    :dep_posted,
		    :dep_batch,
		    :fees_posted,
		    :fees_batch,
		    :is_pending,
		    :is_unimp_gifts,
		    :fee_method,
		    :dep_method,
		    :calc_method,
		    :errors
	    from
		    expression('/apps/kardia/modules/rcpt/deposits_import_calc.qy?ledger=' + :parameters:ledger + '&ptime=' + :parameters:ptime + '&period=' + isnull(:parameters:period, '') + '&deposit_batch=' + isnull(:parameters:deposit_batch, '') + '&batchtype=' + isnull(:parameters:batchtype, 'deposits') + '&byfund=' + isnull(:parameters:byfund, '0') + '&pstat=' + isnull(:parameters:pstat, '')) dl
	    ";
    }
