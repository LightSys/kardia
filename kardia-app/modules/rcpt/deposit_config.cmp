$Version=2$
deposit_config "widget/component-decl"
    {
    // Manage online giving deposits / transaction fees rules (i_eg_deposit_config)
    width=940; height=620;
    ledger "widget/parameter" { type=string; default=null; allowchars="0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"; deploy_to_client=yes; }

    dc_vbox "widget/vbox"
	{
	x=0; y=0; width=940; height=620;
	spacing=10;

	// Read-only display of the related ledger-wide configuration settings.
	cfg_hdr "widget/component"
	    {
	    path="/apps/kardia/modules/base/section_label.cmp";
	    height=24;
	    text="Ledger Settings:";
	    }

	cfg_osrc "widget/osrc"
	    {
	    cfg_ledger "widget/parameter" { type=string; param_name=ledger; default=runclient(:ledger:value); }

	    sql = " select
			cash_fund = :c:RcptCashFund,
			cash_fund_desc = (select :f:a_fund_desc from /apps/kardia/data/Kardia_DB/a_fund/rows f where :f:a_ledger_number = :parameters:ledger and :f:a_fund = :c:RcptCashFund),
			cash_acct = :c:RcptCashAcct,
			cash_acct_desc = (select :a:a_acct_desc from /apps/kardia/data/Kardia_DB/a_account/rows a where :a:a_ledger_number = :parameters:ledger and :a:a_account_code = :c:RcptCashAcct),
			fees_fund = :c:EgFeesFund,
			fees_fund_desc = condition(:c:EgFeesFund = '*', 'designated fund of each gift', (select :f:a_fund_desc from /apps/kardia/data/Kardia_DB/a_fund/rows f where :f:a_ledger_number = :parameters:ledger and :f:a_fund = :c:EgFeesFund)),
			fees_acct = :c:EgFeesAcct,
			fees_acct_desc = (select :a:a_acct_desc from /apps/kardia/data/Kardia_DB/a_account/rows a where :a:a_ledger_number = :parameters:ledger and :a:a_account_code = :c:EgFeesAcct)
		    from
			object expression('/apps/kardia/modules/gl/accounting_config.qyp/' + :parameters:ledger) c
		    ";
	    replicasize=2;
	    readahead=2;

	    cfg_hbox1 "widget/hbox"
		{
		height=16;
		spacing=10;

		cfg_cashfund "widget/label" { width=460; value=runclient('Receipting Asset Fund (RcptCashFund): ' + isnull(:cfg_osrc:cash_fund + isnull(' - ' + :cfg_osrc:cash_fund_desc, ''), '(not set)')); }
		cfg_cashacct "widget/label" { width=460; value=runclient('Receipting Asset Account (RcptCashAcct): ' + isnull(:cfg_osrc:cash_acct + isnull(' - ' + :cfg_osrc:cash_acct_desc, ''), '(not set)')); }
		}

	    cfg_hbox2 "widget/hbox"
		{
		height=16;
		spacing=10;

		cfg_feesfund "widget/label" { width=460; value=runclient('Transaction Fees Fund (EgFeesFund): ' + isnull(:cfg_osrc:fees_fund + isnull(' - ' + :cfg_osrc:fees_fund_desc, ''), '(not set)')); }
		cfg_feesacct "widget/label" { width=460; value=runclient('Transaction Fees Account (EgFeesAcct): ' + isnull(:cfg_osrc:fees_acct + isnull(' - ' + :cfg_osrc:fees_acct_desc, ''), '(not set)')); }
		}
	    }

	cfg_note "widget/label"
	    {
	    height=30;
	    style=italic;
	    text="These ledger settings are maintained in System Configuration (Receipting / Deposits and Online Giving tabs).  For rules using the Payable fees method, the Receipting Asset Fund is used when the rule does not specify a fund.";
	    }

	// The list of deposits / fees rules.
	rules_hdr "widget/component"
	    {
	    path="/apps/kardia/modules/base/section_label.cmp";
	    height=24;
	    width=400;
	    text="Online Giving Deposits / Fees Rules:";
	    }

	rules_osrc "widget/osrc"
	    {
	    rules_ledger "widget/parameter" { type=string; param_name=ledger; default=runclient(:ledger:value); }

	    sql = " select
			:dc:a_ledger_number,
			:dc:i_eg_depfee_id,
			:dc:i_eg_service,
			:dc:i_eg_processor,
			:dc:i_eg_gift_currency,
			:dc:i_eg_gift_pmt_type,
			:dc:i_eg_deposit_method,
			:dc:i_eg_fees_method,
			:dc:i_eg_fees_fund,
			:dc:i_eg_fees_account_code,
			:dc:i_eg_fees_payee,
			:dc:i_eg_calc_method,
			:dc:i_eg_calc_rounding,
			:dc:i_eg_fee_flat_amt,
			:dc:i_eg_fee_pct_amt,
			:dc:s_date_created,
			:dc:s_created_by,
			:dc:s_date_modified,
			:dc:s_modified_by,
			svc_label = condition(:dc:i_eg_service is null, '(any)', isnull((select :pl:description from object wildcard '/apps/kardia/modules/*/plugin_rcpt_giftimport_*.cmp' pl where :pl:tag = :dc:i_eg_service), :dc:i_eg_service)),
			proc_label = isnull(:dc:i_eg_processor, '(any)'),
			curr_label = isnull(:dc:i_eg_gift_currency, '(any)'),
			type_label = isnull(:dc:i_eg_gift_pmt_type, '(any)'),
			dep_label = condition(:dc:i_eg_deposit_method = 'G', 'Gross', condition(:dc:i_eg_deposit_method = 'N', 'Net', 'None')),
			fees_label = condition(:dc:i_eg_fees_method = 'N', 'Net', condition(:dc:i_eg_fees_method = 'D', 'Daily Disb.', condition(:dc:i_eg_fees_method = 'P', 'Payable', 'None'))),
			fees_gl = condition(:dc:i_eg_fees_method = 'P', isnull(rtrim(:dc:i_eg_fees_fund), '(asset fund)') + ' / ' + isnull(rtrim(:dc:i_eg_fees_account_code), '(none)'), ''),
			fees_gl_desc = condition(:dc:i_eg_fees_method = 'P', :f:a_fund_desc + ' / ' + :a:a_acct_desc, null),
			payee_name = condition(:dc:i_eg_fees_payee is null, '', condition(char_length(rtrim(:p:p_org_name)) > 0, :p:p_org_name, :p:p_given_name + ' ' + :p:p_surname)),
			calc_label = condition(:dc:i_eg_calc_method = 'M', 'Manual', 'From Import'),
			calc_desc = condition(:dc:i_eg_calc_method = 'M', isnull(convert(string, :dc:i_eg_fee_flat_amt), '$0.00') + ' + ' + isnull(convert(string, round(:dc:i_eg_fee_pct_amt * 100.0, 4)), '0') + '%', null)
		    from
			identity /apps/kardia/data/Kardia_DB/i_eg_deposit_config/rows dc,
			/apps/kardia/data/Kardia_DB/a_fund/rows f,
			/apps/kardia/data/Kardia_DB/a_account/rows a,
			/apps/kardia/data/Kardia_DB/p_partner/rows p
		    where
			:dc:a_ledger_number = :parameters:ledger and
			:f:a_ledger_number =* :dc:a_ledger_number and
			:f:a_fund =* :dc:i_eg_fees_fund and
			:a:a_ledger_number =* :dc:a_ledger_number and
			:a:a_account_code =* :dc:i_eg_fees_account_code and
			:p:p_partner_key =* :dc:i_eg_fees_payee
		    order by
			:dc:i_eg_service,
			:dc:i_eg_processor,
			:dc:i_eg_gift_currency,
			:dc:i_eg_gift_pmt_type,
			:dc:i_eg_depfee_id
		    ";
	    baseobj = "/apps/kardia/data/Kardia_DB/i_eg_deposit_config/rows";
	    replicasize=50;
	    readahead=50;

	    rules_table "widget/table"
		{
		height=414;
		titlebar=yes;
		colsep=0;
		overlap_scrollbar=yes;
		demand_scrollbar=yes;
		initial_selection = no;
		rowheight=null;
		cellvspacing=4;
		inner_padding=2;
		row_border_radius=6;
		row_shadow_radius=2;
		row_shadow_offset=1;
		row_shadow_color="#a0a0a0";
		row_shadow_angle=135;

		t_svc "widget/table-column" { title="Service"; width=130; fieldname=svc_label; style=bold; }
		t_proc "widget/table-column" { title="Processor"; width=100; fieldname=proc_label; style=bold; }
		t_curr "widget/table-column" { title="Currency"; width=65; fieldname=curr_label; style=bold; }
		t_type "widget/table-column" { title="Pmt Type"; width=80; fieldname=type_label; style=bold; }
		t_dep "widget/table-column" { title="Deposits"; width=65; fieldname=dep_label; }
		t_fees "widget/table-column" { title="Fees"; width=80; fieldname=fees_label; }
		t_gl "widget/table-column" { title="Payable Fund/Acct"; width=150; fieldname=fees_gl; caption_fieldname=fees_gl_desc; }
		t_payee "widget/table-column" { title="Payee"; width=130; fieldname=payee_name; }
		t_calc "widget/table-column" { title="Fee Calc"; width=120; fieldname=calc_label; caption_fieldname=calc_desc; }

		rules_detail "widget/table-row-detail"
		    {
		    width=920; height=250;
		    show_on_new=1;

		    rules_detail_pane "widget/pane"
			{
			x=8; y=5; width=902; height=240;
			style=flat;
			bgcolor="#f8f8f8";
			border_radius=4;

			rules_form "widget/form"
			    {
			    allow_query=no;

			    // Validation: deposit method / fees method combination.
			    //   Net deposits (N) allow only Net fees (N) or no fees import (X).
			    //   Gross deposits (G) and no deposits import (X) allow D, P, or X, but not N.
			    block_save_on_bad_methods "widget/connector"
				{
				event=BeforeSave;
				event_condition=runclient((:f_dep:value = 'N' and :f_fees:value != 'N' and :f_fees:value != 'X') or (:f_dep:value != 'N' and :f_fees:value = 'N'));
				event_cancel=runclient((:f_dep:value = 'N' and :f_fees:value != 'N' and :f_fees:value != 'X') or (:f_dep:value != 'N' and :f_fees:value = 'N'));
				event_delay=0.25;
				target=f_fees;
				action=SetFocus;
				}

			    // Validation: payable fees need a payable GL account.
			    block_save_on_no_acct "widget/connector"
				{
				event=BeforeSave;
				event_condition=runclient(:f_fees:value = 'P' and not (char_length(:f_feeacct:content) > 0));
				event_cancel=runclient(:f_fees:value = 'P' and not (char_length(:f_feeacct:content) > 0));
				event_delay=0.25;
				target=f_feeacct;
				action=SetFocus;
				}

			    // Validation: the payable fund is fixed, so the '*' (designated fund) option is not allowed.
			    block_save_on_star_fund "widget/connector"
				{
				event=BeforeSave;
				event_condition=runclient(charindex('*', isnull(:f_feefund:content, '')) > 0);
				event_cancel=runclient(charindex('*', isnull(:f_feefund:content, '')) > 0);
				event_delay=0.25;
				target=f_feefund;
				action=SetFocus;
				}

			    // Column 1: match criteria
			    match_vbox "widget/vbox"
				{
				x=10; y=10; width=270; height=170;
				spacing=5;
				cellsize=20;

				match_lbl "widget/label" { height=16; style=bold; text="Match Gifts On:"; }

				f_service "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=dropdown; field=i_eg_service; width=270; label_width=90; text="Service:"; sql="select label=:description, value=:tag from object wildcard '/apps/kardia/modules/*/plugin_rcpt_giftimport_*.cmp' order by :description"; numdisplay=8; }
				f_proc "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=dropdown; field=i_eg_processor; width=270; label_width=90; text="Processor:"; sql=runserver("select label=:i_eg_processor, value=:i_eg_processor from /apps/kardia/data/Kardia_DB/i_eg_gift_import/rows where :a_ledger_number = " + quote(:this:ledger) + " and :i_eg_processor is not null group by :i_eg_processor order by :i_eg_processor"); numdisplay=8; }
				f_curr "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=dropdown; field=i_eg_gift_currency; width=270; label_width=90; text="Currency:"; sql=runserver("select label=:i_eg_gift_currency, value=:i_eg_gift_currency from /apps/kardia/data/Kardia_DB/i_eg_gift_import/rows where :a_ledger_number = " + quote(:this:ledger) + " and :i_eg_gift_currency is not null group by :i_eg_gift_currency order by :i_eg_gift_currency"); numdisplay=8; }
				f_type "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=dropdown; field=i_eg_gift_pmt_type; width=270; label_width=90; text="Payment Type:"; sql="select label='Visa', value='Visa'; select label='MasterCard', value='MasterCard'; select label='Discover', value='Discover'; select label='Amex', value='Amex'; select label='Paypal', value='Paypal'; select label='ACH', value='ACH'"; numdisplay=8; }

				match_note "widget/label" { height=45; style=italic; text="Leave a value blank to match anything.  To match several (but not all) values, create one rule for each value."; }
				}

			    // Column 2: deposit and fees methods
			    methods_vbox "widget/vbox"
				{
				x=290; y=10; width=340; height=195;
				spacing=5;
				cellsize=20;

				methods_lbl "widget/label" { height=16; style=bold; text="Deposits and Fees:"; }

				f_dep "widget/component"
				    {
				    path="/sys/cmp/smart_field.cmp";
				    ctl_type=dropdown;
				    field=i_eg_deposit_method;
				    width=340;
				    label_width=110;
				    text="Deposit Method:";
				    sql="select label='Net Deposits', value='N'; select label='Gross Deposits', value='G'; select label='No Deposits Import', value='X'";
				    dep_hints "widget/hints" { style=notnull; default=runclient('N'); }

				    // Limit the fees method choices to those valid for this deposit method.
				    dep_setgroup "widget/connector"
					{
					event=DataChange;
					target=f_fees;
					action=SetGroup;
					Group=runclient(condition(:Value = 'N', 'N', 'G'));
					}

				    // When the user changes the deposit method, reset an incompatible fees method.
				    dep_fixfees_n "widget/connector"
					{
					event=DataChange;
					event_condition=runclient(:FromOSRC == 0 and :Value = 'N' and not (:f_fees:value = 'N' or :f_fees:value = 'X'));
					event_delay=0.1;
					target=f_fees;
					action=SetValue;
					Value=runclient('N');
					}
				    dep_fixfees_g "widget/connector"
					{
					event=DataChange;
					event_condition=runclient(:FromOSRC == 0 and :Value != 'N' and (:f_fees:value = 'N' or :f_fees:value is null));
					event_delay=0.1;
					target=f_fees;
					action=SetValue;
					Value=runclient('D');
					}
				    }

				f_fees "widget/component"
				    {
				    path="/sys/cmp/smart_field.cmp";
				    ctl_type=dropdown;
				    field=i_eg_fees_method;
				    width=340;
				    label_width=110;
				    text="Fees Method:";
				    // Fourth column is the dropdown group, which matches the deposit method (N, or G for both G and X).
				    sql="select label='Net (deducted from deposit)', value='N', sel=0, grp='N'; select label='No Fees Import', value='X', sel=0, grp='N'; select label='Daily Disbursements', value='D', sel=0, grp='G'; select label='Payable GL Account', value='P', sel=0, grp='G'; select label='No Fees Import', value='X', sel=0, grp='G'";
				    fees_hints "widget/hints" { style=notnull; default=runclient('N'); }

				    // Payable fund/account apply only to the Payable fees method.
				    fees_enab_fund "widget/connector" { event=DataChange; event_condition=runclient(:Value = 'P'); target=f_feefund; action=Enable; }
				    fees_enab_acct "widget/connector" { event=DataChange; event_condition=runclient(:Value = 'P'); target=f_feeacct; action=Enable; }
				    fees_disab_fund "widget/connector" { event=DataChange; event_condition=runclient(not (:Value = 'P')); target=f_feefund; action=Disable; }
				    fees_disab_acct "widget/connector" { event=DataChange; event_condition=runclient(not (:Value = 'P')); target=f_feeacct; action=Disable; }
				    fees_clear_fund "widget/connector" { event=DataChange; event_condition=runclient(:FromOSRC == 0 and not (:Value = 'P')); target=f_feefund; action=SetValue; Value=runclient(null); }
				    fees_clear_acct "widget/connector" { event=DataChange; event_condition=runclient(:FromOSRC == 0 and not (:Value = 'P')); target=f_feeacct; action=SetValue; Value=runclient(null); }

				    // Payee currently applies only to the Daily Disbursements fees method.
				    fees_enab_payee "widget/connector" { event=DataChange; event_condition=runclient(:Value = 'D'); target=f_payee; action=Enable; }
				    fees_disab_payee "widget/connector" { event=DataChange; event_condition=runclient(not (:Value = 'D')); target=f_payee; action=Disable; }
				    fees_clear_payee "widget/connector" { event=DataChange; event_condition=runclient(:FromOSRC == 0 and not (:Value = 'D')); target=f_payee; action=SetValue; Value=runclient(null); }
				    }

				f_feefund "widget/component"
				    {
				    width=340;
				    label_width=110;
				    path="/apps/kardia/modules/base/editbox_table.cmp";
				    field=i_eg_fees_fund;
				    text="Payable Fund:";
				    tooltip="Fund holding the transaction fees payable account (usually the general fund)";
				    empty_desc="default: asset fund";
				    popup_width=360;
				    popup_height=250;
				    popup_sql=runserver("
					    SELECT
						value = :a_fund,
						label = :a_fund + ' - ' + :a_fund_desc
					    FROM
						/apps/kardia/data/Kardia_DB/a_fund/rows c
					    WHERE
						:a_ledger_number = " + quote(:this:ledger)
					    );
				    search_field_list="a_fund,*a_fund_desc*,a_legacy_code";
				    key_name="a_fund";
				    object_name="Fund";
				    popup_text="Choose Fund:";
				    attach_point=editbox;
				    }

				f_feeacct "widget/component"
				    {
				    width=340;
				    label_width=110;
				    path="/apps/kardia/modules/base/editbox_tree.cmp";
				    field=i_eg_fees_account_code;
				    text="Payable Account:";
				    tooltip="Transaction fees payable (liability) GL account";
				    empty_desc="liability account";
				    popup_source=runserver("/apps/kardia/modules/gl/accounts.qyt/" + :this:ledger + "/");
				    popup_text="Choose Account:";
				    attach_point=editbox;
				    }

				f_payee "widget/component"
				    {
				    width=340;
				    label_width=110;
				    path="/apps/kardia/modules/disb/field_payee_with_new.cmp";
				    field=i_eg_fees_payee;
				    label="Fees Payee";
				    object_name="Payee";
				    ledger=runserver(:this:ledger);
				    }

				payable_note "widget/label" { height=45; style=italic; text="Payable: enter the fees payable (liability) GL account and the fund that holds it (usually the general fund).  If the fund is blank, the Receipting Asset Fund is used."; }
				}

			    // Column 3: fee calculation
			    calc_vbox "widget/vbox"
				{
				x=640; y=10; width=250; height=170;
				spacing=5;
				cellsize=20;

				calc_lbl "widget/label" { height=16; style=bold; text="Fee Calculation:"; }

				f_calc "widget/component"
				    {
				    path="/sys/cmp/smart_field.cmp";
				    ctl_type=dropdown;
				    field=i_eg_calc_method;
				    width=250;
				    label_width=100;
				    text="Calc Method:";
				    sql="select label='Provided by Import', value='I'; select label='Manual Calculation', value='M'";
				    calc_hints "widget/hints" { style=notnull; default=runclient('I'); }

				    // Rounding, flat fee, and percent fee apply only to manual calculation.
				    calc_enab_round "widget/connector" { event=DataChange; event_condition=runclient(:Value = 'M'); target=f_round; action=Enable; }
				    calc_enab_flat "widget/connector" { event=DataChange; event_condition=runclient(:Value = 'M'); target=f_flat; action=Enable; }
				    calc_enab_pct "widget/connector" { event=DataChange; event_condition=runclient(:Value = 'M'); target=f_pct; action=Enable; }
				    calc_disab_round "widget/connector" { event=DataChange; event_condition=runclient(not (:Value = 'M')); target=f_round; action=Disable; }
				    calc_disab_flat "widget/connector" { event=DataChange; event_condition=runclient(not (:Value = 'M')); target=f_flat; action=Disable; }
				    calc_disab_pct "widget/connector" { event=DataChange; event_condition=runclient(not (:Value = 'M')); target=f_pct; action=Disable; }
				    calc_clear_round "widget/connector" { event=DataChange; event_condition=runclient(:FromOSRC == 0 and :Value = 'I'); target=f_round; action=SetValue; Value=runclient(null); }
				    calc_clear_flat "widget/connector" { event=DataChange; event_condition=runclient(:FromOSRC == 0 and :Value = 'I'); target=f_flat; action=SetValue; Value=runclient(null); }
				    calc_clear_pct "widget/connector" { event=DataChange; event_condition=runclient(:FromOSRC == 0 and :Value = 'I'); target=f_pct; action=SetValue; Value=runclient(null); }
				    }

				f_round "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=dropdown; field=i_eg_calc_rounding; width=250; label_width=100; text="Rounding:"; sql="select label='Round Normally', value='R'; select label='Always Round Down', value='D'; select label='Always Round Up', value='U'"; }
				f_flat "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=editbox; field=i_eg_fee_flat_amt; width=250; label_width=100; text="Flat Fee:"; tooltip="Flat amount charged per gift, e.g. 0.30"; }
				f_pct "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=editbox; field=i_eg_fee_pct_amt; width=250; label_width=100; text="Percent Fee:"; tooltip="Percentage as a decimal, e.g. 0.029 for 2.9%"; empty_desc="e.g. 0.029 = 2.9%"; }

				calc_note "widget/label" { height=30; style=italic; text="Percent fee is a decimal fraction of the gift amount (0.029 = 2.9%)."; }
				}

			    rules_meta "widget/component" { path="/apps/kardia/modules/base/record_metadata_hidden.cmp"; }
			    ledger_var "widget/variable" { fieldname=a_ledger_number; type=string; lv_hints "widget/hints" { default=runclient(:ledger:value); } }

			    // Buttons and validation message
			    btns_hbox "widget/hbox"
				{
				x=10; y=208; width=880; height=24;
				spacing=10;
				align=right;

				invalid_lbl "widget/label"
				    {
				    width=470;
				    height=24;
				    fgcolor="#c00000";
				    style=bold;
				    value=runclient(condition((:f_dep:value = 'N' and :f_fees:value != 'N' and :f_fees:value != 'X') or (:f_dep:value != 'N' and :f_fees:value = 'N'), 'Net deposits require Net fees or No Fees Import.', condition(:f_fees:value = 'P' and not (char_length(:f_feeacct:content) > 0), 'Payable fees require a payable GL account.', condition(charindex('*', isnull(:f_feefund:content, '')) > 0, 'The payable fund must be a specific fund, not *.', ''))));
				    }

				save_btn "widget/textbutton"
				    {
				    width=120;
				    height=24;
				    text="Save";
				    enabled=runclient(:rules_form:is_savable);
				    on_save "widget/connector" { event=Click; target=rules_form; action=Save; }
				    }

				discard_btn "widget/textbutton"
				    {
				    width=120;
				    height=24;
				    text="Cancel";
				    enabled=runclient(:rules_form:is_discardable);
				    on_discard "widget/connector" { event=Click; target=rules_form; action=Discard; }
				    }

				delete_btn "widget/textbutton"
				    {
				    width=120;
				    height=24;
				    text="Delete";
				    enabled=runclient(:rules_form:is_editable);
				    on_delete "widget/connector" { event=Click; target=rules_form; action=Delete; }
				    }
				}
			    }
			}
		    }
		}
	    }

	ctls_hbox "widget/hbox"
	    {
	    height=24;
	    align=right;

	    new_ctl "widget/textbutton"
		{
		width=130;
		height=24;
		text="New Rule";
		enabled=runclient(:rules_form:is_newable);
		on_new "widget/connector" { event=Click; target=rules_form; action=New; }
		}
	    }
	}
    }
