$Version=2$
plugin_rcpt_giftimport_EGS "widget/component-decl"
    {
    // In the future this will be an actual visual config tool,
    // but for now we just use it to supply the infrastructure.
    description = "Vanco Payments Electronic Giving via XML / POST API";
    tag = "VP";
    sql = "		i_eg_service = 'VP',
			i_eg_processor = 'Vanco Payments',
			i_eg_gift_currency = 'USD',
			i_eg_receipt_desired = null,
			i_eg_anonymous = null,
			i_eg_prayforme = null,
			i_eg_acctmap_future = 1,
			i_eg_fundmap_future = 1,
			i_eg_donormap_future = 1,
			s_date_created = getdate(),
			s_created_by = user_name(),
			s_date_modified = getdate(),
			s_modified_by = user_name(),

			:c:i_eg_gift_uuid,
			:c:i_eg_desig_uuid,
			:c:i_eg_trx_uuid,
			:c:i_eg_donor_uuid,
			:c:i_eg_donor_alt_id,
			:c:i_eg_account_uuid,

			:c:i_eg_status,
			:c:i_eg_returned_status,

			:c:i_eg_donor_name,
			i_eg_donor_given_name = condition(char_length(:c:i_eg_donor_given_name) < 1, NULL, :c:i_eg_donor_given_name),
			i_eg_donor_surname= condition(char_length(:c:i_eg_donor_surname) < 1, NULL, :c:i_eg_donor_surname),
			i_eg_donor_middle_name = condition(char_length(:c:i_eg_donor_middle_name) < 1, NULL, :c:i_eg_donor_middle_name),
			i_eg_donor_prefix = NULL,
			i_eg_donor_suffix = NULL,
			i_eg_donor_address = condition(char_length(:c:i_eg_donor_address) < 1, NULL, :c:i_eg_donor_address),
			i_eg_donor_addr1 = condition(char_length(:c:i_eg_donor_addr1) < 1, NULL, :c:i_eg_donor_addr1),
			i_eg_donor_addr2 = condition(char_length(:c:i_eg_donor_addr2) < 1, NULL, :c:i_eg_donor_addr2),
			i_eg_donor_addr3 = NULL,
			i_eg_donor_city = condition(char_length(:c:i_eg_donor_city) < 1, NULL, :c:i_eg_donor_city),
			i_eg_donor_state = condition(char_length(:c:i_eg_donor_state) < 1, NULL, :c:i_eg_donor_state),
			i_eg_donor_postal = condition(char_length(:c:i_eg_donor_postal) < 1, NULL, :c:i_eg_donor_postal),
			i_eg_donor_country = condition(char_length(:c:i_eg_donor_country) < 1, NULL, :c:i_eg_donor_country),
			i_eg_donor_phone = condition(char_length(:c:i_eg_donor_phone) < 1, NULL, :c:i_eg_donor_phone),
			i_eg_donor_email = condition(char_length(:c:i_eg_donor_email) < 1, NULL, :c:i_eg_donor_email),

			:c:i_eg_gift_amount,
			:c:i_eg_net_amount,
			:c:i_eg_deposit_gross_amt,
			:c:i_eg_deposit_amt,
			:c:i_eg_deposit_date,
			:c:i_eg_deposit_status,
			:c:i_eg_deposit_uuid,
			:c:i_eg_gift_pmt_type,
			:c:i_eg_gift_interval,
			:c:i_eg_gift_start_date,
			:c:i_eg_gift_end_date,
			:c:i_eg_gift_date,
			:c:i_eg_gift_trx_date,
			:c:i_eg_gift_settlement_date,
			:c:i_eg_gift_lastfour,
			:c:i_eg_desig_name,
			:c:i_eg_desig_notes
			
		FROM
			/apps/kardia/modules/eg_vanco/combined.qy c
		";

    upsert_sql="ON DUPLICATE
			:a_ledger_number, :i_eg_trx_uuid, :i_eg_desig_uuid, :i_eg_service
		UPDATE SET
			:i_eg_deposit_date = :c:i_eg_deposit_date,
			:i_eg_deposit_uuid = :c:i_eg_deposit_uuid,
			:i_eg_deposit_gross_amt = :c:i_eg_deposit_gross_amt,
			:i_eg_deposit_amt = :c:i_eg_deposit_amt,
			:i_eg_gift_amount = :c:i_eg_gift_amount,
			:i_eg_net_amount = :c:i_eg_net_amount,
			:i_eg_desig_notes = :c:i_eg_desig_notes,
			:i_eg_postprocess = :postproc_str:value,
			:i_eg_status = :c:i_eg_status,
			:i_eg_returned_status = :c:i_eg_returned_status,
			:i_eg_gift_settlement_date = :c:i_eg_gift_settlement_date,
			:s_date_modified = getdate() IF MODIFIED,
			:s_modified_by = user_name() IF MODIFIED
		";

    postprocess_sql="
		print 'Done!'
		";
			
    }
