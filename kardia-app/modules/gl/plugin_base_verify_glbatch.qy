$Version=2$
plugin_base_verify_glbatch "system/query"
    {
    // Metadata
    verify_types = "glbatch,glperiod,glledger,gl";

    // Parameter
    ledger "query/parameter" { type=string; }
    batch "query/parameter" { type=integer; }
    period "query/parameter" { type=string; }
    transactions "query/parameter" { type=collection; style=notnull; }

    sql = " DECLARE OBJECT conf;

	    SELECT :conf:ixa = isnull(nullif((select :a_config_value from /apps/kardia/data/Kardia_DB/a_config/rows c where :c:a_config_name = 'GLIfaAcct' and :c:a_ledger_number = :parameters:ledger), ''), '1900');

	    -- Batch period/date mismatch
	    SELECT
		    name = :b:a_ledger_number + '|' + :b:a_batch_number,
		    type = 'GL Batch',
		    context = 'Ledger ' + :b:a_ledger_number + ', Batch ' + :b:a_batch_number,
		    msg = 'Default effective date ' + dateformat(:b:a_default_effective_date, 'yyyy-MM-dd') + ' is not within period ' + :b:a_period
	    FROM
		    /apps/kardia/data/Kardia_DB/a_batch/rows b,
		    /apps/kardia/data/Kardia_DB/a_period/rows p
	    WHERE
		    (:b:a_ledger_number = :parameters:ledger or :parameters:ledger is null) and
		    (:b:a_batch_number = :parameters:batch or :parameters:batch is null) and
		    (:b:a_period = :parameters:period or :parameters:period is null) and
		    :p:a_ledger_number = :b:a_ledger_number and
		    :p:a_period = :b:a_period and
		    (:b:a_default_effective_date < :b:a_start_date or :b:a_default_effective_date > :b:a_end_date)
	    ;

	    -- Mix of posted and unposted trx
	    SELECT
		    name = :t:a_ledger_number + '|' + :t:a_batch_number,
		    type = 'GL Batch',
		    context = 'Ledger ' + :t:a_ledger_number + ', Batch ' + :t:a_batch_number,
		    msg = 'Has a mix of posted and unposted transactions (Posted: ' + isnull(sum(condition(:t:a_posted = 1, 1, 0)),0) + ' vs. Unposted: ' + isnull(sum(condition(:t:a_posted = 0, 1, 0)),0) + ')'
	    FROM
		    collection transactions t
	    WHERE
		    (:t:a_ledger_number = :parameters:ledger or :parameters:ledger is null) and
		    (:t:a_batch_number = :parameters:batch or :parameters:batch is null) and
		    (:t:a_period = :parameters:period or :parameters:period is null)
	    GROUP BY
		    :t:a_ledger_number,
		    :t:a_batch_number
	    HAVING
		    isnull(sum(condition(:t:a_posted = 1, 1, 0)),0) > 0 and 
		    isnull(sum(condition(:t:a_posted = 0, 1, 0)),0) > 0
	    ;

	    -- Overall batch balance
	    SELECT
		    name = :t:a_ledger_number + '|' + :t:a_batch_number,
		    type = 'GL Batch',
		    context = 'Ledger ' + :t:a_ledger_number + ', Batch ' + :t:a_batch_number,
		    msg = 'Does not balance (' + sum(:t:a_amount) + ')'
	    FROM
		    collection transactions t
	    WHERE
		    (:t:a_ledger_number = :parameters:ledger or :parameters:ledger is null) and
		    (:t:a_batch_number = :parameters:batch or :parameters:batch is null) and
		    (:t:a_period = :parameters:period or :parameters:period is null)
	    GROUP BY
		    :t:a_ledger_number,
		    :t:a_batch_number
	    HAVING
		    sum(:t:a_amount) != $0
	    ;

	    -- Fund Balance within a Batch (may need IXA)
	    SELECT
		    name = :t:a_ledger_number + '|' + :t:a_batch_number + '|' + :c:a_bal_fund,
		    type = 'GL Batch',
		    context = 'Ledger ' + :t:a_ledger_number + ', Batch ' + :t:a_batch_number + ', Fund ' + :t:a_fund,
		    msg = 'Fund does not balance (' + sum(:t:a_amount) + ') - needs IXA?'
	    FROM
		    identity collection transactions t,
		    /apps/kardia/data/Kardia_DB/a_fund/rows c
	    WHERE
		    (:t:a_ledger_number = :parameters:ledger or :parameters:ledger is null) and
		    (:t:a_batch_number = :parameters:batch or :parameters:batch is null) and
		    (:t:a_period = :parameters:period or :parameters:period is null) and
		    :t:a_ledger_number = :c:a_ledger_number and
		    :t:a_fund = :c:a_fund
	    GROUP BY
		    :t:a_ledger_number,
		    :t:a_batch_number,
		    :c:a_bal_fund
	    HAVING
		    sum(:t:a_amount) != $0
	    ;

	    -- Interfund Transfer Asset within a Batch
	    SELECT
		    name = :t:a_ledger_number + '|' + :t:a_batch_number,
		    type = 'GL Batch',
		    context = 'Ledger ' + :t:a_ledger_number + ', Batch ' + :t:a_batch_number,
		    msg = 'Has an imbalanced IXA account ' + (:conf:ixa) + ' total (' + sum(:t:a_amount) + ')'
	    FROM
		    collection transactions t
	    WHERE
		    (:t:a_ledger_number = :parameters:ledger or :parameters:ledger is null) and
		    (:t:a_batch_number = :parameters:batch or :parameters:batch is null) and
		    (:t:a_period = :parameters:period or :parameters:period is null) and
		    :t:a_account_code = :conf:ixa
	    GROUP BY
		    :t:a_ledger_number,
		    :t:a_batch_number
	    HAVING
		    sum(:t:a_amount) != $0
	    ";
    }
