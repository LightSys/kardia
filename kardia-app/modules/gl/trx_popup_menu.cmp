$Version=2$
trx_popup_menu "widget/component-decl"
    {
    width=640;
    height=480;

    X "widget/parameter" { type=integer; default=0; deploy_to_client=yes; }
    Y "widget/parameter" { type=integer; default=0; deploy_to_client=yes; }
    ledger "widget/parameter" { type=string; default=null; deploy_to_client=yes; }
    period "widget/parameter" { type=string; default=null; deploy_to_client=yes; }
    batch "widget/parameter" { type=integer; default=null; deploy_to_client=yes; }
    acct "widget/parameter" { type=string; default=null; deploy_to_client=yes; }
    cc "widget/parameter" { type=string; default=null; deploy_to_client=yes; }
    jnl "widget/parameter" { type=integer; default=null; deploy_to_client=yes; }
    editor "widget/parameter" { type=object; deploy_to_client=yes; }
    acctbal "widget/parameter" { type=object; deploy_to_client=yes; }
    viewer "widget/parameter" { type=object; deploy_to_client=yes; }
    title "widget/parameter" { type=string; default="Menu"; deploy_to_client=yes; }
    legacy "widget/parameter" { type=string; default=null; deploy_to_client=yes; }
    origin "widget/parameter" { type=string; default=null; deploy_to_client=yes; }
    amount "widget/parameter" { type=money; default=null; deploy_to_client=yes; }
    year "widget/parameter" { type=string; default=null; style=strnull; deploy_to_client=yes; }

    LoadComplete_cn "widget/connector"
	{
	event = "LoadComplete";
	target=menu;
	action="Popup";
	X = runclient(:trx_popup_menu:X);
	Y = runclient(:trx_popup_menu:Y);
	}

    menu "widget/menu"
	{
	widget_class = "popup";

	menutitle "widget/menutitle" { label = runserver(:this:title); }
	sep0 "widget/menusep" { }

	per_item "widget/menuitem"
	    {
	    condition = runserver(not (:this:period is null));
	    label = runserver('Browse Period ' + :this:period);
	    per_cn "widget/connector" { event=Select; target=viewer; action=Browse; a_period=runclient(:trx_popup_menu:period); year=runclient(:year:value); }
	    }
	batch_item "widget/menuitem"
	    {
	    condition = runserver(not (:this:batch is null));
	    label = runserver('Browse Batch ' + :this:batch); 
	    batch_cn "widget/connector" { event=Select; target=viewer; action=Browse; a_batch_number=runclient(:trx_popup_menu:batch); year=runclient(:year:value); }
	    }
//	jnl_item "widget/menuitem"
//	    {
//	    condition = runserver(not (:this:jnl is null));
//	    label = runserver('Browse Batch ' + :this:batch + ', Journal ' + :this:jnl);
//	    jnl_batch_cn "widget/connector" { event=Select; target=viewer; action=Browse; a_batch_number=runclient(:trx_popup_menu:batch); a_journal_number=runclient(:trx_popup_menu:jnl);}
//	    }
	bcc_item "widget/menuitem"
	    {
	    condition = runserver((not (:this:cc is null)) and (not (:this:batch is null)));
	    label = runserver('Browse Batch ' + :this:batch + ', Fund ' + :this:cc);
	    bcc_cn "widget/connector" { event=Select; target=viewer; action=Browse; a_fund=runclient(:trx_popup_menu:cc); a_batch_number=runclient(:trx_popup_menu:batch); year=runclient(:year:value); }
	    }
	acct_item "widget/menuitem"
	    {
	    condition = runserver(not (:this:acct is null));
	    label = runserver('Browse Account ' + :this:acct);
	    acct_cn "widget/connector" { event=Select; target=viewer; action=Browse; a_account_code=runclient(:trx_popup_menu:acct); year=runclient(:year:value); }
	    }
	cc_item "widget/menuitem"
	    {
	    condition = runserver(not (:this:cc is null));
	    label = runserver('Browse Fund ' + :this:cc); 
	    cc_cn "widget/connector" { event=Select; target=viewer; action=Browse; a_fund=runclient(:trx_popup_menu:cc); year=runclient(:year:value); }
	    }
	acc_item "widget/menuitem"
	    {
	    condition = runserver((not (:this:cc is null)) and (not (:this:acct is null)));
	    label = runserver('Browse Fund ' + :this:cc + ', Account ' + :this:acct);
	    acc_cn "widget/connector" { event=Select; target=viewer; action=Browse; a_fund=runclient(:trx_popup_menu:cc); a_account_code=runclient(:trx_popup_menu:acct); year=runclient(:year:value); }
	    }
	amt_cr_item "widget/menuitem"
	    {
	    condition = runserver(:this:amount is not null);
	    label = runserver('Browse Credits of ' + condition(:this:amount > 0, :this:amount, $0 - :this:amount));
	    amt_cr_cn "widget/connector" { event=Select; target=viewer; action=Browse; amount=runclient(runserver(convert(integer, condition(:this:amount > $0, $0 - :this:amount, :this:amount) * 100))); year=runclient(:year:value); }
	    }
	amt_dr_item "widget/menuitem"
	    {
	    condition = runserver(:this:amount is not null);
	    label = runserver('Browse Debits of ' + condition(:this:amount > 0, :this:amount, $0 - :this:amount));
	    amt_dr_cn "widget/connector" { event=Select; target=viewer; action=Browse; amount=runclient(runserver(convert(integer, condition(:this:amount < $0, $0 - :this:amount, :this:amount) * 100))); year=runclient(:year:value); }
	    }

	sep1 "widget/menusep" { }

	viewlegacy_item "widget/menuitem"
	    { 
	    condition = runserver(not (:this:legacy is null));
	    label = runserver('View Filepro Trx ' + :this:legacy); 
	    //edit_cn "widget/connector" { event=Select; target=editor; action=GotoBatch; Batch=runclient(:trx_popup_menu:batch); }
	    }
	editbatch_item "widget/menuitem"
	    { 
	    condition = runserver(not (:this:batch is null));
	    label = runserver('Open Batch ' + :this:batch + ' in Journal Entry'); 
	    edit_cn "widget/connector" { event=Select; target=viewer; action=EditBatch; Batch=runclient(:trx_popup_menu:batch); }
	    }
	editcr_item "widget/menuitem"
	    {
	    condition = runserver(:this:batch is not null and :this:origin = 'CR');
	    label = runserver('Open Batch ' + :this:batch + ' in Gift Entry'); 
	    editcr_cn "widget/connector" { event=Select; target=viewer; action=EditCRBatch; Batch=runclient(:trx_popup_menu:batch); }
	    }
	editcd_item "widget/menuitem"
	    {
	    condition = runserver(:this:batch is not null and :this:origin = 'CD');
	    label = runserver('Open Batch ' + :this:batch + ' in Disbursements'); 
	    editcd_cn "widget/connector" { event=Select; target=viewer; action=EditCDBatch; Batch=runclient(:trx_popup_menu:batch); }
	    }

	sep2 "widget/menusep" { }

	printbatch_item "widget/menuitem"
	    {
	    condition = runserver(not (:this:batch is null));
	    label = runserver('Transaction Report for Batch ' + :this:batch); 
	    printbatch_cn "widget/connector" { event=Select; target=viewer; action=PrintTrx; a_batch_number=runclient(:trx_popup_menu:batch); year=runclient(:year:value); }
	    }
	printfund_item "widget/menuitem"
	    {
	    condition = runserver(:this:cc is not null);
	    label = runserver('Transaction Report for Fund ' + :this:cc); 
	    printfund_cn "widget/connector" { event=Select; target=viewer; action=PrintTrx; a_fund=runclient(:trx_popup_menu:cc); year=runclient(:year:value); }
	    }
	printacct_item "widget/menuitem"
	    {
	    condition = runserver(:this:cc is not null);
	    label = runserver('Transaction Report for Account ' + :this:acct); 
	    printacct_cn "widget/connector" { event=Select; target=viewer; action=PrintTrx; a_account_code=runclient(:trx_popup_menu:acct); year=runclient(:year:value); }
	    }

//	balcc_item "widget/menuitem"
//	    { 
//	    condition = runserver(not (:this:cc is null));
//	    label = runserver('Show Balances for ' + :this:cc); 
//	    balcc_cn "widget/connector" { event=Select; target=acctbal; action=ShowBalances; Fund=runclient(:trx_popup_menu:cc); Account=runclient(null); }
//	    }
//	balccacct_item "widget/menuitem"
//	    { 
//	    condition = runserver((not (:this:cc is null)) and (not (:this:acct is null)));
//	    label = runserver('Show Balance for ' + :this:cc + ':' + :this:acct); 
//	    balccacct_cn "widget/connector" { event=Select; target=acctbal; action=ShowBalances; Fund=runclient(:trx_popup_menu:cc); Account=runclient(:trx_popup_menu:acct); }
//	    }
	}
    }
