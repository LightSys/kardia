					    popup_source = runserver("/apps/kardia/modules/gl/accounts.qyt/" + :this:ledger + "/");
					    popup_text="Select Account:";
					    empty_desc="select an account";

					    acct_value_change "widget/connector" { event=DataChange; event_delay=0.1; target=acct_value_form; action=Save; }
					    }
					acct_value_save "widget/component" { path="/sys/cmp/save_btn.cmp"; x=664; y=4; width=18; height=18; }
					}
				    }

				// Manual cash account: pick a single cash account for all imported lines
				cash_value_edit "widget/table-row-detail"
				    {
				    height=32;
				    width=733;
				    display_for=runclient(:i2f_fields_osrc:userfield == '(manual)' and :i2f_fields_osrc:kardiafield == 'Cash Account');

				    cash_value_form "widget/form"
					{
					cash_value_picker "widget/component"
					    {
					    x=354; y=4; width=300; height=24;
					    path="/apps/kardia/modules/base/editbox_tree.cmp";
					    field="value";
					    text="";
					    label_width=10;
					    popup_source = runserver("/apps/kardia/modules/gl/accounts.qyt/" + :this:ledger + "/");
					    popup_text="Select Cash Account:";
					    empty_desc="select a cash account";

					    cash_value_change "widget/connector" { event=DataChange; event_delay=0.1; target=cash_value_form; action=Save; }
					    }
					cash_value_save "widget/component" { path="/sys/cmp/save_btn.cmp"; x=664; y=4; width=18; height=18; }
					}
				    }

				flt_field "widget/table-column" { fieldname=kardiafield; caption_fieldname=descrip; wrap=yes; width=150; style=bold; title="Kardia Field"; }
				flt_yourfield "widget/table-column" { value=runclient(isnull(:i2f_fields_osrc:userfield, '') + condition(:i2f_fields_osrc:userfield == '(manual)' and :i2f_fields_osrc:value is not null, ' - ' + :i2f_fields_osrc:value + isnull(' (' + :i2f_fields_osrc:value_desc + ')', ''), '')); width=150; style=bold; title="From Your Data"; }
				}
			    }
			}

		    i2f_ctls_hbox "widget/hbox"
			{
			height=24;
			align=center;
			spacing=473;

			i2f_prev "widget/textbutton"
			    {
			    text = "<< Previous";
			    height=24;
			    width=130;

			    on_i2f_prev "widget/connector"
				{
				event=Click;
				target=import_tab;
				action=SetTab;
				TabIndex=1;
				}
			    }

			i2f_next "widget/textbutton"
			    {
			    text = "Next >>";
			    height=24;
			    width=130;

			    on_i2f_next "widget/connector"
				{
				event=Click;
				target=import_tab;
				action=SetTab;
				TabIndex=3;
				}
			    }
			}
		    }
		}

	    import_3_preview "widget/tabpage"
		{
		i3p_vbox "widget/vbox"
		    {
		    x=10;
		    y=10;
		    width=733;
		    height=658;
		    spacing=10;

		    i3p_title "widget/component"
			{
			path="/apps/kardia/modules/base/section_label.cmp";
			height=26;
			fl_height=0;
			text="Step 3:  Preview Data To Be Imported";
			}

		    preview_osrc "widget/osrc"
			{
			i3p_f_filename "widget/parameter" { param_name=filename; type=string; default=runclient(:file_osrc:name); }
			i3p_f_ledger "widget/parameter" { param_name=ledger; type=string; default=runclient(:ledger:value); }
			i3p_f_batch "widget/parameter" { param_name=batch; type=integer; default=runclient(:batch:value); }

			sql = " exec /apps/kardia/modules/disb/disb_import_preview.qy filename=:parameters:filename, ledger=:parameters:ledger, batch=:parameters:batch ";

			readahead=200;
			replicasize=200;
			autoquery=oneachreveal;

			preview_table "widget/table"
			    {
			    height=462;
			    titlebar=yes;
			    overlap_scrollbar=yes;
			    demand_scrollbar=yes;
			    rowheight=null;
			    cellvspacing=4;
			    inner_padding=2;
			    colsep=0;
			    row_border_radius=6;
			    row_shadow_radius=2;
			    row_shadow_offset=1;
			    row_shadow_color="#a0a0a0";
			    row_shadow_angle=135;

			    //pt_line "widget/table-column" { title="#"; fieldname=line_no; width=30; }
			    //pt_disb "widget/table-column" { title="Disb"; fieldname=a_disbursement_id; width=35; }
			    pt_date "widget/table-column" { title="Date"; fieldname=date_txt; width=75; style=bold; }
			    pt_ckno "widget/table-column" { title="Ck#"; fieldname=a_check_number; width=55; style=bold; }
			    //pt_item "widget/table-column" { title="Line"; fieldname=a_line_item; width=30; style=bold; }
			    pt_payee "widget/table-column" { title="Payee"; fieldname=payee_txt; caption_fieldname=payee_id; width=120; style=bold; }
			    pt_fund "widget/table-column" { title="Fund"; fieldname=a_fund; caption_fieldname=fund_txt; width=70; style=bold; }
			    pt_acct "widget/table-column" { title="Acct"; fieldname=a_account_code; caption_fieldname=acct_txt; width=60; style=bold; }
			    pt_cash "widget/table-column" { title="CashAcct"; fieldname=a_cash_account_code; caption_fieldname=cashacct_txt; width=60; style=bold; }
			    pt_amt "widget/table-column" { title="Amount"; fieldname=a_amount; width=80; align=right; style=bold; }
			    pt_comm "widget/table-column" { title="Comment/Memo"; fieldname=a_comment; caption_fieldname=a_memo; width=120; style=bold; }
			    }
			}

		    summary_osrc "widget/osrc"
			{
			i3p_s_filename "widget/parameter" { param_name=filename; type=string; default=runclient(:file_osrc:name); }
			i3p_s_ledger "widget/parameter" { param_name=ledger; type=string; default=runclient(:ledger:value); }
			i3p_s_batch "widget/parameter" { param_name=batch; type=integer; default=runclient(:batch:value); }

			sql = " select
				    linecnt = count(1),
				    disbcnt = isnull(max(:p:a_disbursement_id) - min(:p:a_disbursement_id) + 1, 0),
				    total = isnull(sum(:p:a_amount), $0)
				from
				    expression('/apps/kardia/modules/disb/disb_import_preview.qy?filename=' + :parameters:filename + '&ledger=' + :parameters:ledger + '&batch=' + :parameters:batch) p
				";

			readahead=2;
			replicasize=2;
			autoquery=oneachreveal;

			summary_label "widget/label"
			    {
			    height=16;
			    align=center;
			    style=bold;
			    value=runclient(condition(:summary_osrc:cx__pending, 'Calculating totals...', 'To be imported: ' + isnull(:summary_osrc:linecnt, 0) + ' line item(s) in ' + isnull(:summary_osrc:disbcnt, 0) + ' disbursement(s), totaling ' + isnull(:summary_osrc:total, '$0.00') + '.'));
			    }
			}

		    validity_osrc "widget/osrc"
			{
			i3p_v_filename "widget/parameter" { param_name=filename; type=string; default=runclient(:file_osrc:name); }
			i3p_v_ledger "widget/parameter" { param_name=ledger; type=string; default=runclient(:ledger:value); }
			i3p_v_batch "widget/parameter" { param_name=batch; type=integer; default=runclient(:batch:value); }

			sql = " declare collection disb_import scope application;
				delete from collection disb_import;

				insert into
				    collection disb_import
				select
				    *,
				    a_ledger_number = :parameters:ledger,
				    a_batch_number = :parameters:batch
				from
				    expression('/apps/kardia/modules/disb/disb_import_preview.qy?filename=' + :parameters:filename + '&ledger=' + :parameters:ledger + '&batch=' + :parameters:batch)
				;

				exec /apps/kardia/modules/disb/disb_import_verify.qy ledger=:parameters:ledger, batch=:parameters:batch
				";

			autoquery = oneachreveal;
			replicasize = 10;
			readahead = 10;

			disb_validity_tbl "widget/table"
			    {
			    height=90;
			    mode=dynamicrow;
			    titlebar=no;
			    demand_scrollbar=yes;
			    overlap_scrollbar = yes;
			    show_selection = no;
			    nodata_message = runclient(condition(not :validity_osrc:cx__pending, "checking disbursements; one moment...", "(no problems found)"));

			    t_linev "widget/table-column" { title=""; fieldname="line_txt"; width=60; }
			    t_disbv "widget/table-column" { title=""; fieldname="disb_txt"; width=60; }
			    t_msg "widget/table-column" { title="Correct any issues shown below:"; fieldname="msg"; width=580; textcolor=runclient('#f00000'); }
			    }
			}

		    i3p_ctls_hbox "widget/hbox"
			{
			height=24;
			align=center;
			spacing=10;

			i3p_prev "widget/textbutton"
			    {
			    text = "<< Previous";
			    height=24;
			    width=130;

			    on_i3p_prev "widget/connector"
				{
				event=Click;
				target=import_tab;
				action=SetTab;
				TabIndex=2;
				}
			    }

			i3p_label "widget/label"
			    {
			    fl_width=30;
			    width=453;
			    align=center;
			    value=runclient(condition(:validity_osrc:msg is not null, 'Please correct any errors before continuing.', ''));
			    }

			i3p_next "widget/textbutton"
			    {
			    text = "Next >>";
			    height=24;
			    width=130;
			    enabled=runclient(:validity_osrc:msg is null and not :validity_osrc:cx__pending);

			    on_i3p_next "widget/connector"
				{
				event=Click;
				target=import_tab;
				action=SetTab;
				TabIndex=4;
				}
			    }
			}
		    }
		}

	    import_4_finalize "widget/tabpage"
		{
		i4f_vbox "widget/vbox"
		    {
		    x=10;
		    y=10;
		    width=733;
		    height=658;
		    spacing=10;

		    i4f_title "widget/component"
			{
			path="/apps/kardia/modules/base/section_label.cmp";
			height=26;
			fl_height=0;
			text="Step 4:  Import The Data";
			}

		    ib_hbox "widget/hbox"
			{
			height=24;
			align=center;

			i4f_import_btn "widget/textbutton"
			    {
			    height=24;
			    width=130;
			    text = "Import Data";

			    do_import "widget/connector" { event=Click; target=i4f_do_import; action=QueryParam; }
			    }
			}
		    ia_hbox "widget/hbox"
			{
			height=24;
			align=center;

			i4f_approval "widget/component"
			    {
			    path = "/sys/cmp/smart_field.cmp";
			    height = 24;
			    width = 150;
			    label_width = 125;
			    ctl_type = checkbox;
			    text = "Mark all as approved:";

			    approval_hints_1 "widget/hints"
				{
				condition=runserver( (select isnull(first(:a_config_value), 'N') from /apps/kardia/data/Kardia_DB/a_config/rows where :a_ledger_number = :this:ledger and :a_config_name = 'DisbApprovals') = 'Y');
				style=notnull;
				}
			    approval_hints_2 "widget/hints"
				{
				condition=runserver( (select isnull(first(:a_config_value), 'N') from /apps/kardia/data/Kardia_DB/a_config/rows where :a_ledger_number = :this:ledger and :a_config_name = 'DisbApprovals') != 'Y');
				style=notnull,readonly;
				}
			    }
			}

		    i4f_status "widget/label"
			{
			height=12;
			align=center;
			value=runclient("Status: Import not started");
			}

		    i4f_note "widget/label"
			{
			height=24;
			align=center;
			style=italic;
			value=runclient(condition(runserver((select isnull(first(:a_config_value), 'N') from /apps/kardia/data/Kardia_DB/a_config/rows where :a_ledger_number = :this:ledger and :a_config_name = 'DisbApprovals') = 'Y'), condition(:i4f_approval:value, "Imported disbursements are all marked as approved", "Imported disbursements are not approved; review, edit, and approve them in the Disbursements application."), "Review imported disbursements afterward in the Disbursements application."));
			}

		    i4f_sep "widget/autolayoutspacer" { height=464; }

		    i4f_ctls_hbox "widget/hbox"
			{
			height=24;
			align=center;
			spacing=473;

			i4f_prev "widget/textbutton"
			    {
			    text = "<< Previous";
			    height=24;
			    width=130;

			    on_i4f_prev "widget/connector"
				{
				event=Click;
				target=import_tab;
				action=SetTab;
				TabIndex=3;
				}
			    }

			i4f_next "widget/textbutton"
			    {
			    text = "Start Again";
			    height=24;
			    width=130;

			    on_i4f_next "widget/connector"
				{
				event=Click;
				target=import_tab;
				action=SetTab;
				TabIndex=1;
				}
			    }
			}
		    }

		i4f_do_import "widget/osrc"
		    {
		    i4f_f_filename "widget/parameter" { param_name=filename; type=string; default=runclient(:file_osrc:name); }
		    i4f_f_ledger "widget/parameter" { param_name=ledger; type=string; default=runclient(:ledger:value); }
		    i4f_f_batch "widget/parameter" { param_name=batch; type=integer; default=runclient(:batch:value); }
		    i4f_f_period "widget/parameter" { param_name=period; type=string; default=runclient(:info_osrc:a_period); }
		    i4f_f_maxid "widget/parameter" { param_name=maxid; type=integer; default=runclient(:info_osrc:maxid); }
		    i4f_f_approve "widget/parameter" { param_name=approval; type=integer; default=runclient(condition(:i4f_approval:value, 1, 0)); }

		    sql = " insert
				/apps/kardia/data/Kardia_DB/a_subtrx_cashdisb/rows cd
			    select
				a_ledger_number = :parameters:ledger,
				a_batch_number = :parameters:batch,
				:p:a_disbursement_id,
				:p:a_line_item,
				a_period = :parameters:period,
				:p:a_effective_date,
				:p:a_cash_account_code,
				:p:a_amount,
				:p:a_fund,
				:p:a_account_code,
				:p:a_payee_partner_key,
				:p:a_check_number,
				a_posted = 0,
				a_posted_to_gl = 0,
				a_voided = 0,
				a_reconciled = 0,
				a_approved_by=condition(:parameters:approval = 1, user_name(), null),
				a_approved_date=condition(:parameters:approval = 1, getdate(), null),
				:p:a_memo,
				:p:a_comment,
				s_date_created = getdate(),
				s_created_by = user_name(),
				s_date_modified = getdate(),
				s_modified_by = user_name()
			    from
				expression('/apps/kardia/modules/disb/disb_import_preview.qy?filename=' + :parameters:filename + '&ledger=' + :parameters:ledger + '&batch=' + :parameters:batch) p
			    ;

			    select
				importcnt = count(1),
				disbcnt = isnull(max(:a_disbursement_id) - min(:a_disbursement_id) + 1, 0),
				total = isnull(sum(:a_amount), $0)
			    from
				/apps/kardia/data/Kardia_DB/a_subtrx_cashdisb/rows cd
			    where
				:a_ledger_number = :parameters:ledger and
				:a_batch_number = :parameters:batch and
				:a_disbursement_id > :parameters:maxid
			    ";

		    readahead=2;
		    replicasize=2;
		    autoquery=never;

		    on_import "widget/connector" { event=EndQuery; target=i4f_status; action=SetValue; Value=runclient('Import complete.  ' + :i4f_do_import:importcnt + ' line items imported in ' + :i4f_do_import:disbcnt + ' disbursements, totaling ' + :i4f_do_import:total + '.'); }
		    on_import2 "widget/connector" { event=EndQuery; target=info_osrc; action=Refresh; }
		    refresh_parent_on_import "widget/connector" { event=EndQuery; target=send_refresh; action=Refresh; Batch=runclient(:batch:value); }
		    }
		}
	    }
	}

    popover_nogo "widget/childwindow"
	{
	widget_class="popover";
	width=400; height=120;
	x=290; y=280;

	nogo_vbox "widget/vbox"
	    {
	    x=10; y=10;
	    width=378;
	    height=198;
	    spacing=10;

	    nogo_title "widget/label" { height=16; font_size=16; style=bold; align=center; value=runclient("Cannot Import Into Batch " + :batch:value); }

	    nogo_desc "widget/label" { height=48; value=runclient("Batch " + isnull(:batch:value, "(not specified)") + " in ledger " + isnull(:ledger:value, "(not specified)") + " is not eligible for modification because " + condition(:info_osrc:a_batch_number is null, "it could not be located in the system", condition(:info_osrc:posted != 'No', "it has already been posted", "it is a " + :info_osrc:a_origin + " batch rather than a Cash Disbursements batch")) + ".  Please select a different batch to import data into."); }
	    }
	}
    }
