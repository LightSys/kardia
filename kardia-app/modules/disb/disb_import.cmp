$Version=2$
disb_import "widget/component-decl"
    {
    width=980; height=680;

    // CSV import of disbursements into a Cash Disbursements (CD) batch.
    // Modeled on /apps/kardia/modules/gl/gl_import.cmp.
    //
    // Uploaded files are stored in /apps/kardia/files/disb, which must exist
    // and be writable by the Centrallix server.

    ledger "widget/parameter" { type=string; default=null; allowchars="0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"; deploy_to_client=yes; }
    batch "widget/parameter" { type=integer; default=null; deploy_to_client=yes; }
    send_refresh "widget/parameter" { type=object; default=null; deploy_to_client=yes; }

    import_hbox "widget/hbox"
	{
	x=0; y=0; width=980; height=680;
	spacing=15;

	info_osrc "widget/osrc"
	    {
	    o_ledger "widget/parameter" { type=string; param_name=ledger; default=runclient(:ledger:value); }
	    o_batch "widget/parameter" { type=integer; param_name=batch; default=runclient(:batch:value); }
	    sql = " select
			:l:a_ledger_number,
			:l:a_ledger_desc,
			:b:a_batch_number,
			:b:a_batch_desc,
			:b:a_period,
			:b:a_origin,
			batch_info = '' + :b:a_batch_number + ' - ' + :b:a_batch_desc,
			date_txt = isnull(dateformat(:b:a_default_effective_date, 'yyyy-MM-dd'), '(none)'),
			total = (select isnull(sum(:cd:a_amount), $0) from /apps/kardia/data/Kardia_DB/a_subtrx_cashdisb/rows cd where :cd:a_ledger_number = :b:a_ledger_number and :cd:a_batch_number = :b:a_batch_number and isnull(:cd:a_voided, 0) = 0),
			recs = (select count(1) from /apps/kardia/data/Kardia_DB/a_subtrx_cashdisb/rows cd where :cd:a_ledger_number = :b:a_ledger_number and :cd:a_batch_number = :b:a_batch_number),
			posted = condition((select count(1) from /apps/kardia/data/Kardia_DB/a_subtrx_cashdisb/rows cd where :cd:a_ledger_number = :b:a_ledger_number and :cd:a_batch_number = :b:a_batch_number and (:cd:a_posted = 1 or :cd:a_posted_to_gl = 1)) > 0, 'Yes', 'No'),
			maxid = (select isnull(max(:cd:a_disbursement_id), 0) from /apps/kardia/data/Kardia_DB/a_subtrx_cashdisb/rows cd where :cd:a_ledger_number = :b:a_ledger_number and :cd:a_batch_number = :b:a_batch_number)
		    from
			/apps/kardia/data/Kardia_DB/a_ledger/rows l,
			/apps/kardia/data/Kardia_DB/a_batch/rows b
		    where
			:l:a_ledger_number = :parameters:ledger and
			:b:a_ledger_number = :l:a_ledger_number and
			:b:a_batch_number = :parameters:batch
		    ";
	    autoquery=onload;
	    replicasize=2;
	    readahead=2;

	    on_batch_load "widget/connector"
		{
		event=EndQuery;
		event_condition=runclient(:info_osrc:posted != 'No' or :info_osrc:a_origin != 'CD' or :info_osrc:a_batch_number is null);
		target=popover_nogo;
		action=Open;
		IsModal=1;
		}

	    info_form "widget/form"
		{
		info_pane "widget/pane"
		    {
		    width=210;
		    style=flat;
		    bgcolor="#f8f8f8";
		    border_radius=12;
		    shadow_radius=4;
		    shadow_offset=2;
		    shadow_color="#808080";
		    shadow_angle=135;

		    info_vbox "widget/vbox"
			{
			x=10; y=10;
			width=188;
			height=678;
			spacing=10;

			info_title "widget/component"
			    {
			    path="/apps/kardia/modules/base/section_label.cmp";
			    height=26;
			    fl_height=0;
			    text="Import Into Batch:";
			    }

			info_ledger "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=label; height=12; label_width=60; text="Ledger:"; field=a_ledger_number; }
			info_batch "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=label; height=24; label_width=60; label_valign=top; text="Batch:"; field=batch_info; }
			info_period "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=label; height=12; label_width=60; text="Period:"; field=a_period; }
			info_date "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=label; height=12; label_width=60; text="Eff. Date:"; field=date_txt; }
			info_total "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=label; height=12; label_width=60; text="Total:"; field=total; }
			info_recs "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=label; height=12; label_width=60; text="Lines:"; field=recs; }
			info_post "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=label; height=12; label_width=60; text="Posted:"; field=posted; }

			sep1 "widget/autolayoutspacer" { height=10; }

			file_title "widget/component"
			    {
			    path="/apps/kardia/modules/base/section_label.cmp";
			    height=26;
			    fl_height=0;
			    text="From File:";
			    }

			file_name "widget/label" { height=24; value=runclient('File: '); }
			file_recs "widget/label" { height=12; value=runclient('Records: '); }
			}
		    }
		}
	    }

	import_tab "widget/tab"
	    {
	    width=755;
	    tab_location=none;
	    bgcolor="#f8f8f8";
	    border_radius=12;
	    shadow_radius=4;
	    shadow_offset=2;
	    shadow_color="#808080";
	    shadow_angle=135;

	    import_1_file "widget/tabpage"
		{
		i1f_vbox "widget/vbox"
		    {
		    x=10;
		    y=10;
		    width=733;
		    height=658;
		    spacing=10;

		    i1f_title "widget/component"
			{
			path="/apps/kardia/modules/base/section_label.cmp";
			height=26;
			fl_height=0;
			text="Step 1:  Select or Upload a File";
			}

		    file_osrc "widget/osrc"
			{
			sql = "	select
				    :name,
				    :size,
				    :last_modification
				from
				    identity /apps/kardia/files/disb
				where
				    right(:name, 4) = '.csv'
				order by default
				    :last_modification desc
				";
			replicasize=200;
			readahead=200;
			autoquery=oneachreveal;

			file_table "widget/table"
			    {
			    height=588;
			    titlebar=no;
			    overlap_scrollbar=yes;
			    demand_scrollbar=yes;
			    rowheight=null;
			    cellvspacing=4;
			    inner_padding=2;
			    colsep=0;
			    row_border_radius=6;
			    row_shadow_radius=2;
			    row_shadow_offset=1;
			    row_shadow_color="#a0a0a0";
			    row_shadow_angle=135;
			    nodata_message = runclient(condition(not :file_osrc:cx__pending, "one moment...", "(no files yet)"));

			    ft_selectbar "widget/table-row-detail"
				{
				height=30;

				ft_form "widget/form"
				    {
				    ft_hbox "widget/hbox"
					{
					x=0; y=5;
					width=731;
					height=24;
					spacing=10;
					align=center;

					ft_select "widget/textbutton"
					    {
					    height=24;
					    width=130;
					    text = "Import This File";

					    ft_on_select "widget/connector"
						{
						event=Click;
						target=import_tab;
						action=SetTab;
						TabIndex=2;
						}
					    }

					ft_delete "widget/textbutton"
					    {
					    height=24;
					    width=130;
					    text = "Delete File";

					    ft_on_delete "widget/connector"
						{
						event=Click;
						target=ft_form;
						action=Delete;
						}
					    }
					}
				    }
				}

			    ft_name "widget/table-column" { fieldname=name; width=400; }
			    ft_size "widget/table-column" { fieldname=size; width=100; }
			    ft_date "widget/table-column" { fieldname=last_modification; width=200; }
			    }

			ft_upload "widget/textbutton"
			    {
			    height=24;
			    width=130;
			    text = "Upload File...";

			    on_select "widget/connector"
				{
				event=Click;
				target=upload;
				action=Prompt;
				}
			    }

			upload "widget/fileupload"
			    {
			    multiselect = no;
			    fieldname = "file";
			    target = "/apps/kardia/files/disb";

			    on_file_selected "widget/connector"
				{
				event=DataChange;
				action=Submit;
				}

			    on_complete "widget/connector"
				{
				event=UploadComplete;
				target=file_osrc;
				action=Refresh;
				}

			    on_error "widget/connector"
				{
				event=UploadError;
				target=disb_import;
				action=Alert;
				Message=runclient("File upload failed.  Please make sure your uploaded file is a .csv file.");
				}
			    }
			}
		    }
		}

	    import_2_fields "widget/tabpage"
		{
		i2f_vbox "widget/vbox"
		    {
		    x=10;
		    y=10;
		    width=733;
		    height=658;
		    spacing=10;

		    i2f_title "widget/component"
			{
			path="/apps/kardia/modules/base/section_label.cmp";
			height=26;
			fl_height=0;
			text="Step 2:  Configure Import Data Fields";
			}

		    i2f_file_osrc "widget/osrc"
			{
			i2f_filename "widget/parameter" { param_name=filename; type=string; default=runclient(:file_osrc:name); }
			sql = " select
				    fname = :parameters:filename,
				    reccnt = (select count(1) from expression ('/apps/kardia/files/disb/' + :parameters:filename + '/rows')),
				    fieldcnt = (select count(1) from expression ('/apps/kardia/files/disb/' + :parameters:filename + '/columns')),
				    fields = (select isnull(sum(:name + ', ') - ', ', '(none available)') from expression ('/apps/kardia/files/disb/' + :parameters:filename + '/columns'))
				";
			replicasize=2;
			readahead=2;
			autoquery=oneachreveal;

			update_filename "widget/connector" { event=EndQuery; target=file_name; action=SetValue; Value=runclient('File: ' + isnull(:i2f_file_osrc:fname, '')); }
			update_filerecs "widget/connector" { event=EndQuery; target=file_recs; action=SetValue; Value=runclient('Records: ' + isnull(:i2f_file_osrc:reccnt, '')); }
			update_status "widget/connector" { event=EndQuery; target=i4f_status; action=SetValue; Value=runclient("Status: Import not started."); }

			on_fileinfo_load_date "widget/connector"
			    {
			    event=EndQuery;
			    target=date_dd;
			    action=SetItems;
			    SQL = runclient("select label='(batch default)', value='(batch default)'; select label='(today)', value='(today)'; select label='(manual)', value='(manual)'; select label = :name, value = :name from /apps/kardia/files/disb/" + :i2f_file_osrc:fname + "/columns");
			    }

			on_fileinfo_load_payee "widget/connector"
			    {
			    event=EndQuery;
			    target=payee_dd;
			    action=SetItems;
			    SQL = runclient("select label='(manual)', value='(manual)'; select label = :name, value = :name from /apps/kardia/files/disb/" + :i2f_file_osrc:fname + "/columns");
			    }

			on_fileinfo_load_grp "widget/connector"
			    {
			    event=EndQuery;
			    target=grp_dd;
			    action=SetItems;
			    SQL = runclient("select label='(one per payee)', value='(one per payee)'; select label='(one per line)', value='(one per line)'; select label = :name, value = :name from /apps/kardia/files/disb/" + :i2f_file_osrc:fname + "/columns");
			    }

			on_fileinfo_load_amt "widget/connector"
			    {
			    event=EndQuery;
			    target=amt_dd;
			    action=SetItems;
			    SQL = runclient("select label='(manual)', value='(manual)'; select label = :name, value = :name from /apps/kardia/files/disb/" + :i2f_file_osrc:fname + "/columns");
			    }

			on_fileinfo_load_fund "widget/connector"
			    {
			    event=EndQuery;
			    target=fund_dd;
			    action=SetItems;
			    SQL = runclient("select label='(manual)', value='(manual)'; select label = :name, value = :name from /apps/kardia/files/disb/" + :i2f_file_osrc:fname + "/columns");
			    }

			on_fileinfo_load_acct "widget/connector"
			    {
			    event=EndQuery;
			    target=acct_dd;
			    action=SetItems;
			    SQL = runclient("select label='(default)', value='(default)'; select label='(manual)', value='(manual)'; select label = :name, value = :name from /apps/kardia/files/disb/" + :i2f_file_osrc:fname + "/columns");
			    }

			on_fileinfo_load_cash "widget/connector"
			    {
			    event=EndQuery;
			    target=cash_dd;
			    action=SetItems;
			    SQL = runclient("select label='(default)', value='(default)'; select label='(manual)', value='(manual)'; select label = :name, value = :name from /apps/kardia/files/disb/" + :i2f_file_osrc:fname + "/columns");
			    }

			on_fileinfo_load_ckno "widget/connector"
			    {
			    event=EndQuery;
			    target=ckno_dd;
			    action=SetItems;
			    SQL = runclient("select label='(automatic)', value='(automatic)'; select label='(none)', value='(none)'; select label = :name, value = :name from /apps/kardia/files/disb/" + :i2f_file_osrc:fname + "/columns");
			    }

			on_fileinfo_load_memo "widget/connector"
			    {
			    event=EndQuery;
			    target=memo_dd;
			    action=SetItems;
			    SQL = runclient("select label='(manual)', value='(manual)'; select label = :name, value = :name from /apps/kardia/files/disb/" + :i2f_file_osrc:fname + "/columns");
			    }

			on_fileinfo_load_comm "widget/connector"
			    {
			    event=EndQuery;
			    target=comm_dd;
			    action=SetItems;
			    SQL = runclient("select label='(manual)', value='(manual)'; select label = :name, value = :name from /apps/kardia/files/disb/" + :i2f_file_osrc:fname + "/columns");
			    }

			i2f_file_form "widget/form"
			    {
			    i2f_name "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=label; height=12; label_width=100; text="Filename:"; value=runclient(:file_osrc:name); label_valign=top; }
			    i2f_recs "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=label; height=12; label_width=100; text="# of Records:"; field=reccnt; label_valign=top; }
			    i2f_fields "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=label; height=12; label_width=100; text="# of Fields:"; field=fieldcnt; label_valign=top; }
			    i2f_fieldlist "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=label; height=24; label_width=100; text="Field List:"; field=fields; label_valign=top; }
			    }

			i2f_fields_osrc "widget/osrc"
			    {
			    i2f_f_filename "widget/parameter" { param_name=filename; type=string; default=runclient(:file_osrc:name); }
			    sql = " declare collection fields scope application;
				    declare object fileinfo scope application;

				    -- Only clear the fields collection if we're working with a different file entirely
				    delete from collection fields where (:fileinfo:filename is null or :fileinfo:filename != :parameters:filename);
				    select :fileinfo:filename = :parameters:filename;

				    insert collection fields select ord=1, userfield=convert(string, null), value=convert(string, null), kardiafield='Date', descrip='Effective date of the disbursement line item', moddate=getdate() on duplicate :kardiafield update set :moddate = getdate();
				    insert collection fields select ord=2, userfield=convert(string, null), value=convert(string, null), kardiafield='Payee ID', descrip='Payee partner ID; choose (manual) to pick a single payee for all lines', moddate=getdate() on duplicate :kardiafield update set :moddate = getdate();
				    insert collection fields select ord=3, userfield=convert(string, null), value=convert(string, null), kardiafield='Disbursement Group', descrip='Lines with the same value here become one disbursement (check); or one disbursement per payee or per line', moddate=getdate() on duplicate :kardiafield update set :moddate = getdate();
				    insert collection fields select ord=4, userfield=convert(string, null), value=convert(string, null), kardiafield='Amount', descrip='Line item amount (may be negative, but disbursement totals may not)', moddate=getdate() on duplicate :kardiafield update set :moddate = getdate();
				    insert collection fields select ord=5, userfield=convert(string, null), value=convert(string, null), kardiafield='Fund Code', descrip='Fund or sub-fund code the expense is charged to', moddate=getdate() on duplicate :kardiafield update set :moddate = getdate();
				    insert collection fields select ord=6, userfield=convert(string, null), value=convert(string, null), kardiafield='GL Account Code', descrip='GL expense account code; (default) uses the configured default expense account', moddate=getdate() on duplicate :kardiafield update set :moddate = getdate();
				    insert collection fields select ord=7, userfield=convert(string, null), value=convert(string, null), kardiafield='Cash Account', descrip='Cash (asset) account the disbursement is paid from; (default) uses the configured default', moddate=getdate() on duplicate :kardiafield update set :moddate = getdate();
				    insert collection fields select ord=8, userfield=convert(string, null), value=convert(string, null), kardiafield='Check Number', descrip='Check number; (automatic) numbers checks sequentially, (none) leaves it blank', moddate=getdate() on duplicate :kardiafield update set :moddate = getdate();
				    insert collection fields select ord=9, userfield=convert(string, null), value=convert(string, null), kardiafield='Memo', descrip='Check memo line; must be the same for all lines of a disbursement', moddate=getdate() on duplicate :kardiafield update set :moddate = getdate();
				    insert collection fields select ord=10, userfield=convert(string, null), value=convert(string, null), kardiafield='Comment', descrip='Comments or notes on this disbursement line item', moddate=getdate() on duplicate :kardiafield update set :moddate = getdate();

				    -- Date
				    update
					identity collection fields f,
					expression ('/apps/kardia/files/disb/' + :parameters:filename + '/columns') uf
				    set
					:f:userfield = :uf:name
				    where
					:f:kardiafield = 'Date' and
					(charindex('date', lower(:uf:name)) > 0) and
					:f:userfield is null
				    ;
				    update
					identity collection fields f
				    set
					:f:userfield = '(batch default)'
				    where
					:f:kardiafield = 'Date' and
					:f:userfield is null
				    ;

				    -- Payee ID
				    update
					identity collection fields f,
					expression ('/apps/kardia/files/disb/' + :parameters:filename + '/columns') uf
				    set
					:f:userfield = :uf:name
				    where
					:f:kardiafield = 'Payee ID' and
					(charindex('payee', lower(:uf:name)) > 0 or charindex('partner', lower(:uf:name)) > 0 or charindex('vendor', lower(:uf:name)) > 0) and
					(charindex('name', lower(:uf:name)) == 0) and
					:f:userfield is null
				    ;
				    update
					identity collection fields f
				    set
					:f:userfield = '(manual)'
				    where
					:f:kardiafield = 'Payee ID' and
					:f:userfield is null
				    ;

				    -- Disbursement Group (often the check number column)
				    update
					identity collection fields f,
					expression ('/apps/kardia/files/disb/' + :parameters:filename + '/columns') uf
				    set
					:f:userfield = :uf:name
				    where
					:f:kardiafield = 'Disbursement Group' and
					(charindex('group', lower(:uf:name)) > 0 or charindex('disb', lower(:uf:name)) > 0 or charindex('check', lower(:uf:name)) > 0 or charindex('ckno', lower(:uf:name)) > 0 or charindex('ck#', lower(:uf:name)) > 0) and
					(charindex('date', lower(:uf:name)) == 0) and
					(charindex('amount', lower(:uf:name)) == 0) and
					(charindex('amt', lower(:uf:name)) == 0) and
					(charindex('memo', lower(:uf:name)) == 0) and
					:f:userfield is null
				    ;
				    update
					identity collection fields f
				    set
					:f:userfield = '(one per payee)'
				    where
					:f:kardiafield = 'Disbursement Group' and
					:f:userfield is null
				    ;

				    -- Amount
				    update
					identity collection fields f,
					expression ('/apps/kardia/files/disb/' + :parameters:filename + '/columns') uf
				    set
					:f:userfield = :uf:name
				    where
					:f:kardiafield = 'Amount' and
					(charindex('amount', lower(:uf:name)) > 0 or charindex('amt', lower(:uf:name)) > 0) and
					:f:userfield is null
				    ;
				    update
					identity collection fields f
				    set
					:f:userfield = '(manual)'
				    where
					:f:kardiafield = 'Amount' and
					:f:userfield is null
				    ;

				    -- Fund
				    update
					identity collection fields f,
					expression ('/apps/kardia/files/disb/' + :parameters:filename + '/columns') uf
				    set
					:f:userfield = :uf:name
				    where
					:f:kardiafield = 'Fund Code' and
					(charindex('fund', lower(:uf:name)) > 0) and
					:f:userfield is null
				    ;
				    update
					identity collection fields f
				    set
					:f:userfield = '(manual)'
				    where
					:f:kardiafield = 'Fund Code' and
					:f:userfield is null
				    ;

				    -- GL (expense) Account
				    update
					identity collection fields f,
					expression ('/apps/kardia/files/disb/' + :parameters:filename + '/columns') uf
				    set
					:f:userfield = :uf:name
				    where
					:f:kardiafield = 'GL Account Code' and
					(charindex('account', lower(:uf:name)) > 0 or charindex('acct', lower(:uf:name)) > 0) and
					(charindex('cash', lower(:uf:name)) == 0) and
					:f:userfield is null
				    ;
				    update
					identity collection fields f
				    set
					:f:userfield = '(default)'
				    where
					:f:kardiafield = 'GL Account Code' and
					:f:userfield is null
				    ;

				    -- Cash Account
				    update
					identity collection fields f,
					expression ('/apps/kardia/files/disb/' + :parameters:filename + '/columns') uf
				    set
					:f:userfield = :uf:name
				    where
					:f:kardiafield = 'Cash Account' and
					(charindex('cash', lower(:uf:name)) > 0) and
					:f:userfield is null
				    ;
				    update
					identity collection fields f
				    set
					:f:userfield = '(default)'
				    where
					:f:kardiafield = 'Cash Account' and
					:f:userfield is null
				    ;

				    -- Check Number
				    update
					identity collection fields f,
					expression ('/apps/kardia/files/disb/' + :parameters:filename + '/columns') uf
				    set
					:f:userfield = :uf:name
				    where
					:f:kardiafield = 'Check Number' and
					((charindex('check', lower(:uf:name)) > 0 and (charindex('num', lower(:uf:name)) > 0 or charindex('no', lower(:uf:name)) > 0 or charindex('#', :uf:name) > 0)) or charindex('ckno', lower(:uf:name)) > 0 or charindex('ck#', lower(:uf:name)) > 0) and
					:f:userfield is null
				    ;
				    update
					identity collection fields f
				    set
					:f:userfield = '(automatic)'
				    where
					:f:kardiafield = 'Check Number' and
					:f:userfield is null
				    ;

				    -- Memo
				    update
					identity collection fields f,
					expression ('/apps/kardia/files/disb/' + :parameters:filename + '/columns') uf
				    set
					:f:userfield = :uf:name
				    where
					:f:kardiafield = 'Memo' and
					(charindex('memo', lower(:uf:name)) > 0) and
					:f:userfield is null
				    ;
				    update
					identity collection fields f
				    set
					:f:userfield = '(manual)'
				    where
					:f:kardiafield = 'Memo' and
					:f:userfield is null
				    ;

				    -- Comment
				    update
					identity collection fields f,
					expression ('/apps/kardia/files/disb/' + :parameters:filename + '/columns') uf
				    set
					:f:userfield = :uf:name
				    where
					:f:kardiafield = 'Comment' and
					(charindex('text', lower(:uf:name)) > 0 or charindex('note', lower(:uf:name)) > 0 or charindex('comm', lower(:uf:name)) > 0 or charindex('desc', lower(:uf:name)) > 0) and
					:f:userfield is null
				    ;
				    update
					identity collection fields f
				    set
					:f:userfield = '(manual)'
				    where
					:f:kardiafield = 'Comment' and
					:f:userfield is null
				    ;

				    select
					:f:kardiafield,
					:f:userfield,
					:f:descrip,
					:f:value,
					value_desc = condition(:f:kardiafield = 'Payee ID' and :f:userfield = '(manual)',
						(select condition(char_length(rtrim(:p:p_org_name)) > 1, :p:p_org_name, isnull(:p:p_given_name + ' ', '') + isnull(:p:p_surname, '')) from /apps/kardia/data/Kardia_DB/p_partner/rows p where :p:p_partner_key = :f:value),
						null)
				    from
					collection fields f
				    order by default
					:f:ord
				    ";
			    autoquery=oneachreveal;
			    replicasize=200;
			    readahead=200;

			    i2f_fields_table "widget/table"
				{
				height=488;
				titlebar=yes;
				overlap_scrollbar=yes;
				demand_scrollbar=yes;
				rowheight=null;
				cellvspacing=4;
				inner_padding=2;
				colsep=0;
				row_border_radius=6;
				row_shadow_radius=2;
				row_shadow_offset=1;
				row_shadow_color="#a0a0a0";
				row_shadow_angle=135;

				date_edit "widget/table-row-detail"
				    {
				    height=32;
				    width=733;
				    display_for=runclient(:i2f_fields_osrc:kardiafield == 'Date');

				    date_form "widget/form"
					{
					date_dd "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=dropdown; width=300; label_width=10; height=24; x=354; y=4; field=userfield; numdisplay=12; date_dd_change "widget/connector" { event=DataModify; target=date_form; action=Save; } }
					}
