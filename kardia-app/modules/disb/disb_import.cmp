					}
				    }

				acct_edit "widget/table-row-detail"
				    {
				    height=32;
				    width=733;
				    display_for=runclient(:i2f_fields_osrc:kardiafield == 'GL Account Code');

				    acct_form "widget/form"
					{
					acct_dd "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=dropdown; width=300; label_width=10; height=24; x=354; y=4; field=userfield; numdisplay=12; acct_dd_change "widget/connector" { event=DataModify; target=acct_form; action=Save; } }
					}
				    }

				cash_edit "widget/table-row-detail"
				    {
				    height=32;
				    width=733;
				    display_for=runclient(:i2f_fields_osrc:kardiafield == 'Cash Account');

				    cash_form "widget/form"
					{
					cash_dd "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=dropdown; width=300; label_width=10; height=24; x=354; y=4; field=userfield; numdisplay=12; cash_dd_change "widget/connector" { event=DataModify; target=cash_form; action=Save; } }
					}
				    }

				ckno_edit "widget/table-row-detail"
				    {
				    height=32;
				    width=733;
				    display_for=runclient(:i2f_fields_osrc:kardiafield == 'Check Number');

				    ckno_form "widget/form"
					{
					ckno_dd "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=dropdown; width=300; label_width=10; height=24; x=354; y=4; field=userfield; numdisplay=12; ckno_dd_change "widget/connector" { event=DataModify; target=ckno_form; action=Save; } }
					}
				    }

				memo_edit "widget/table-row-detail"
				    {
				    height=32;
				    width=733;
				    display_for=runclient(:i2f_fields_osrc:kardiafield == 'Memo');

				    memo_form "widget/form"
					{
					memo_dd "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=dropdown; width=300; label_width=10; height=24; x=354; y=4; field=userfield; numdisplay=12; memo_dd_change "widget/connector" { event=DataModify; target=memo_form; action=Save; } }
					}
				    }

				comm_edit "widget/table-row-detail"
				    {
				    height=32;
				    width=733;
				    display_for=runclient(:i2f_fields_osrc:kardiafield == 'Comment');

				    comm_form "widget/form"
					{
					comm_dd "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=dropdown; width=300; label_width=10; height=24; x=354; y=4; field=userfield; numdisplay=12; comm_dd_change "widget/connector" { event=DataModify; target=comm_form; action=Save; } }
					}
				    }

				// Generic manual value entry (Date, Amount, Memo, Comment)
				value_edit "widget/table-row-detail"
				    {
				    height=32;
				    width=733;
				    display_for=runclient(:i2f_fields_osrc:userfield == '(manual)' and :i2f_fields_osrc:kardiafield != 'Payee ID' and :i2f_fields_osrc:kardiafield != 'Fund Code' and :i2f_fields_osrc:kardiafield != 'GL Account Code' and :i2f_fields_osrc:kardiafield != 'Cash Account');

				    value_form "widget/form"
					{
					value_editbox "widget/component" { path="/sys/cmp/smart_field.cmp"; ctl_type=editbox; width=300; label_width=10; height=24; x=354; y=4; field=value; empty_desc="enter a manual value"; value_change "widget/connector" { event=DataChange; event_condition=runclient(:FromKeyboard); event_delay=0.1; target=value_form; action=Save; } }
					value_save "widget/component" { path="/sys/cmp/save_btn.cmp"; x=664; y=4; width=18; height=18; }
					}
				    }

				// Manual payee: pick a single payee for all imported lines
				payee_value_edit "widget/table-row-detail"
				    {
				    height=32;
				    width=733;
				    display_for=runclient(:i2f_fields_osrc:userfield == '(manual)' and :i2f_fields_osrc:kardiafield == 'Payee ID');

				    payee_value_form "widget/form"
					{
					payee_value_picker "widget/component"
					    {
					    x=314; y=6; width=340; height=20;
					    path="/apps/kardia/modules/disb/field_payee_with_new.cmp";
					    field=value;
					    label="Payee";
					    label_width=50;
					    object_name="Payee";
					    ledger=runserver(:this:ledger);

					    payee_value_change "widget/connector" { event=DataChange; event_delay=0.1; target=payee_value_form; action=Save; }
					    }
					payee_value_save "widget/component" { path="/sys/cmp/save_btn.cmp"; x=664; y=4; width=18; height=18; }
					}
				    }

				// Manual fund: pick a single fund for all imported lines
				fund_value_edit "widget/table-row-detail"
				    {
				    height=32;
				    width=733;
				    display_for=runclient(:i2f_fields_osrc:userfield == '(manual)' and :i2f_fields_osrc:kardiafield == 'Fund Code');

				    fund_value_form "widget/form"
					{
					fund_value_picker "widget/component"
					    {
					    x=354; y=4; width=300; height=24;
					    path="/apps/kardia/modules/base/editbox_table.cmp";
					    field="value";
					    text="";
					    label_width=10;
					    popup_width=380;
					    popup_sql=runserver("select value = :c:a_fund, label = :c:a_fund + ' - ' + :c:a_fund_desc from /apps/kardia/data/Kardia_DB/a_fund/rows c where :c:a_is_posting = 1 and :c:a_ledger_number = " + quote(:this:ledger));
					    search_field_list="a_fund*,*a_fund_desc*";
					    key_name="a_fund";
					    object_name="Fund";
					    popup_text="Select Fund:";
					    empty_desc="select a fund";

					    fund_value_hints "widget/hints" { style=applyonchange,uppercase; }

					    fund_value_change "widget/connector" { event=DataChange; event_delay=0.1; target=fund_value_form; action=Save; }
					    }
					fund_value_save "widget/component" { path="/sys/cmp/save_btn.cmp"; x=664; y=4; width=18; height=18; }
					}
				    }

				// Manual GL account: pick a single expense account for all imported lines
				acct_value_edit "widget/table-row-detail"
				    {
				    height=32;
				    width=733;
				    display_for=runclient(:i2f_fields_osrc:userfield == '(manual)' and :i2f_fields_osrc:kardiafield == 'GL Account Code');

				    acct_value_form "widget/form"
					{
					acct_value_picker "widget/component"
					    {
					    x=354; y=4; width=300; height=24;
					    path="/apps/kardia/modules/base/editbox_tree.cmp";
					    field="value";
					    text="";
