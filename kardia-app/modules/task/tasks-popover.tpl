$Version=2$
tasks_popover "widget/template"
    {
    label "widget/label"
	{
	fgcolor=black;
	}

    pane_label_small "widget/pane"
	{
	widget_class=label_small;
	style = flat;
	bgcolor = "#c8c8c8";
	border_color = "#c8c8c8";
	border_radius = 6;
	}

    table "widget/table"
	{
	row1_bgcolor = "#e0e0e0";
	row2_bgcolor = "#e8e8e8";
	rowhighlight_bgcolor = "#c8c8c8";
	textcolor = black;
	textcolorhighlight = black;
	}
    table "widget/table"
	{
	widget_class = "table2";
	hdr_background = null;
	hdr_bgcolor = "#c8c8c8";
	}
    }
